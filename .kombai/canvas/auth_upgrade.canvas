      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n\n  @layer base {\n    body {\n      font-family: 'Be Vietnam Pro', -apple-system, BlinkMacSystemFont, sans-serif;\n      background-color: #FAF7F2;\n      color: #181312;\n      margin: 0;\n    }\n  }\n\n  .font-mono-code {\n    font-family: 'JetBrains Mono', monospace;\n  }\n\n  .slide-bg {\n    transition: opacity 700ms ease-in-out;\n  }\n</style>\n<div class=\"w-full min-h-[900px] bg-[#FAF7F2] text-[#181312] flex flex-col lg:flex-row antialiased selection:bg-[#b40006] selection:text-white\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- LEFT PANEL (60% Desktop): Institutional Civic Crimson & Gold Stage -->\n    <section class=\"relative lg:w-[58%] xl:w-[60%] min-h-[820px] lg:min-h-[900px] bg-[#3B0406] text-white flex flex-col justify-between p-8 sm:p-10 xl:p-14 overflow-hidden select-none\" data-kid=\"1-1\" data-name=\"institutional left showcase panel\">\n        <!-- Architectural Slideshow Backdrop -->\n        <div aria-hidden=\"true\" class=\"absolute inset-0 z-0\" data-kid=\"1-1-1\" data-name=\"architectural slideshow backdrop container\">\n            <img alt=\"Tòa nhà Quốc hội Việt Nam\" class=\"slide-bg absolute inset-0 w-full h-full object-cover object-center opacity-100\" data-dynamic=\"true\" data-kid=\"1-1-1-1\" data-name=\"national assembly backdrop slide image\" data-reason=\"opacity toggled by selectSlide carousel script\" decoding=\"async\" id=\"slide-0\" loading=\"lazy\" src=\"/api/local/images/AI_Legal/public/images/login/national-assembly.jpg\"/>\n            <img alt=\"Trụ sở Tòa án Nhân dân Hà Nội\" class=\"slide-bg absolute inset-0 w-full h-full object-cover object-center opacity-0\" data-dynamic=\"true\" data-kid=\"1-1-1-2\" data-name=\"hanoi court backdrop slide image\" data-reason=\"opacity toggled by selectSlide carousel script\" decoding=\"async\" id=\"slide-1\" loading=\"lazy\" src=\"/api/local/images/AI_Legal/public/images/login/hanoi-court.jpg\"/>\n            <img alt=\"Tòa án Nhân dân Tối cao\" class=\"slide-bg absolute inset-0 w-full h-full object-cover object-center opacity-0\" data-dynamic=\"true\" data-kid=\"1-1-1-3\" data-name=\"supreme court backdrop slide image\" data-reason=\"opacity toggled by selectSlide carousel script\" decoding=\"async\" id=\"slide-2\" loading=\"lazy\" src=\"/api/local/images/AI_Legal/public/images/login/supreme-court.jpg\"/>\n            <img alt=\"Tòa án Nhân dân TP. Hồ Chí Minh\" class=\"slide-bg absolute inset-0 w-full h-full object-cover object-center opacity-0\" data-dynamic=\"true\" data-kid=\"1-1-1-4\" data-name=\"ho chi minh court backdrop slide image\" data-reason=\"opacity toggled by selectSlide carousel script\" decoding=\"async\" id=\"slide-3\" loading=\"lazy\" src=\"/api/local/images/AI_Legal/public/images/login/ho-chi-minh-court.jpg\"/>\n            <!-- Unified Vietnamese Civic Crimson & Warm Obsidian Overlay (replaces muddy green) -->\n            <div class=\"absolute inset-0 bg-gradient-to-br from-[#2B0204]/92 via-[#5E080C]/82 to-[#1E0506]/90\" data-kid=\"1-1-1-5\" data-name=\"crimson gradient overlay for readability\">\n            </div>\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[#240203]/95 via-transparent to-[#3B0406]/55\" data-kid=\"1-1-1-6\" data-name=\"vertical fade gradient overlay\">\n            </div>\n        </div>\n        <!-- Dong Son Drum Cultural Watermark -->\n        <div class=\"absolute -left-[210px] -top-[210px] z-[1] w-[640px] h-[640px] opacity-[0.085] pointer-events-none\" data-kid=\"1-1-2\" data-name=\"dong son drum cultural watermark\">\n            <img alt=\"\" class=\"w-full h-full object-contain invert\" data-kid=\"1-1-2-1\" data-name=\"dong son drum watermark image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/AI_Legal/public/images/login/dong-son-drum-face.png\"/>\n        </div>\n        <!-- Subtle Gold Hairline Frame Border on Right Edge -->\n        <div class=\"hidden lg:block absolute top-0 right-0 bottom-0 w-[1px] bg-gradient-to-b from-transparent via-[#ecc15a]/35 to-transparent z-10\" data-kid=\"1-1-3\" data-name=\"gold hairline frame divider on right edge\">\n        </div>\n        <!-- TOP HEADER: National Motto & System Status -->\n        <header class=\"relative z-10 flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-white/12\" data-kid=\"1-1-4\" data-name=\"header with national motto and system status\">\n            <div class=\"flex items-center gap-3.5\" data-kid=\"1-1-4-1\" data-name=\"national emblem and motto group\">\n                <div class=\"w-12 h-12 rounded-xl bg-gradient-to-b from-[#ecc15a]/25 to-[#8d6b02]/20 border border-[#ecc15a]/45 flex items-center justify-center shadow-sm shrink-0\" data-kid=\"1-1-4-1-1\" data-name=\"national service emblem badge box\">\n                    <img alt=\"Quốc huy / Biểu trưng Dịch vụ công\" class=\"w-9 h-9 object-contain\" data-kid=\"1-1-4-1-1-1\" data-name=\"national service logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/AI_Legal/public/images/national-service-logo.png\"/>\n                </div>\n                <div data-kid=\"1-1-4-1-2\" data-name=\"national motto text block\">\n                    <div class=\"text-xs sm:text-[13px] font-bold tracking-[0.08em] text-[#f5d47a] uppercase\" data-kid=\"1-1-4-1-2-1\" data-name=\"official country name text\">\n                        CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM\n                    </div>\n                    <div class=\"text-xs sm:text-[13px] text-white/85 font-medium mt-0.5\" data-kid=\"1-1-4-1-2-2\" data-name=\"national motto text\">\n                        Độc lập - Tự do - Hạnh phúc\n                    </div>\n                </div>\n            </div>\n            <div class=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/35 border border-[#ecc15a]/30 text-xs font-medium text-[#ffdf99]\" data-kid=\"1-1-4-2\" data-name=\"online system status badge\">\n                <span class=\"w-2 h-2 rounded-full bg-emerald-400\" data-kid=\"1-1-4-2-1\" data-name=\"online status dot\">\n                </span>\n                <span data-kid=\"1-1-4-2-2\" data-name=\"online status label text\">\n                    Cổng xác thực tập trung • Trực tuyến\n                </span>\n            </div>\n        </header>\n        <!-- CENTER STAGE: Institutional Identity & Concrete Legal AI Capabilities -->\n        <div class=\"relative z-10 my-auto py-8 max-w-2xl\" data-kid=\"1-1-5\" data-name=\"center stage with identity and feature list\">\n            <!-- Local Verified Emblem Badge (Replaces broken googleusercontent URL) -->\n            <div class=\"inline-flex items-center gap-3 px-3.5 py-2 rounded-xl bg-white/8 border border-[#ecc15a]/35 mb-6\" data-kid=\"1-1-5-1\" data-name=\"local verified emblem badge\">\n                <div class=\"w-9 h-9 rounded-lg bg-[#ecc15a]/20 border border-[#ecc15a]/50 flex items-center justify-center text-[#f5d47a]\" data-kid=\"1-1-5-1-1\" data-name=\"scales of justice icon box\">\n                    <span class=\"text-xl\" data-kid=\"1-1-5-1-1-1\" data-name=\"scales of justice icon wrapper\">\n                        <i class=\"ti ti-scale\" data-kid=\"1-1-5-1-1-1-1\" data-name=\"scales of justice icon\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"text-left\" data-kid=\"1-1-5-1-2\" data-name=\"badge label group\">\n                    <div class=\"text-[11px] font-semibold uppercase tracking-wider text-[#f5d47a]\" data-kid=\"1-1-5-1-2-1\" data-name=\"system name label\">\n                        Hệ thống Thông tin Giải quyết Thủ tục Hành chính\n                    </div>\n                    <div class=\"text-xs text-white/85\" data-kid=\"1-1-5-1-2-2\" data-name=\"specialized industry subtitle\">\n                        Chuyên ngành Đất đai & Đăng ký Hộ kinh doanh\n                    </div>\n                </div>\n            </div>\n            <h1 class=\"text-3xl sm:text-4xl xl:text-[44px] font-extrabold text-white tracking-tight leading-[1.16] mb-4\" data-kid=\"1-1-5-2\" data-name=\"hero headline\">\n                CỔNG TRỢ LÝ PHÁP LÝ & DỊCH VỤ CÔNG\n            </h1>\n            <p class=\"text-base sm:text-lg text-[#f5d47a] font-medium leading-relaxed mb-8 max-w-xl\" data-kid=\"1-1-5-3\" data-name=\"hero feature description text\">\n                Hệ thống AI Hỗ trợ Hồ sơ Đất đai & Hộ kinh doanh toàn quốc — Đồng bộ dữ liệu công dân, luật sư và cán bộ tiếp nhận.\n            </p>\n            <!-- Concrete Architectural Feature Rows (Solid dark-crimson backing for guaranteed contrast) -->\n            <div class=\"space-y-3.5 max-w-xl\" data-kid=\"1-1-5-4\" data-name=\"architectural feature card list\">\n                <div class=\"flex items-start gap-4 p-4 rounded-xl bg-[#220203]/70 border border-white/14\" data-kid=\"1-1-5-4-1\" data-name=\"land law document review feature card\">\n                    <div class=\"w-11 h-11 rounded-lg bg-[#b40006] border border-[#ecc15a]/40 flex items-center justify-center shrink-0 text-[#ffdf99]\" data-kid=\"1-1-5-4-1-1\" data-name=\"map pin check icon box\">\n                        <span class=\"text-xl\" data-kid=\"1-1-5-4-1-1-1\" data-name=\"map pin check icon wrapper\">\n                            <i class=\"ti ti-map-pin-check\" data-kid=\"1-1-5-4-1-1-1-1\" data-name=\"map pin check icon\">\n                            </i>\n                        </span>\n                    </div>\n                    <div data-kid=\"1-1-5-4-1-2\" data-name=\"feature text group\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-1-5-4-1-2-1\" data-name=\"feature title row with form badge\">\n                            <h2 class=\"text-[15px] font-bold text-white\" data-kid=\"1-1-5-4-1-2-1-1\" data-name=\"feature title text\">\n                                Rà soát & thẩm định hồ sơ theo Luật Đất đai\n                            </h2>\n                            <span class=\"px-2 py-0.5 rounded text-[11px] font-mono-code font-semibold bg-[#ecc15a]/20 text-[#f5d47a] border border-[#ecc15a]/30\" data-kid=\"1-1-5-4-1-2-1-2\" data-name=\"land law form reference badge\">\n                                Mẫu 04/ĐK • 11/ĐK\n                            </span>\n                        </div>\n                        <p class=\"text-[13.5px] text-white/80 mt-1 leading-relaxed\" data-kid=\"1-1-5-4-1-2-2\" data-name=\"feature description text\">\n                            Kiểm tra tính hợp lệ của giấy tờ thửa đất, tờ bản đồ, trích xuất CCCD tự động qua OCR và đối chiếu địa giới hành chính.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex items-start gap-4 p-4 rounded-xl bg-[#220203]/70 border border-white/14\" data-kid=\"1-1-5-4-2\" data-name=\"business registration feature card\">\n                    <div class=\"w-11 h-11 rounded-lg bg-[#b40006] border border-[#ecc15a]/40 flex items-center justify-center shrink-0 text-[#ffdf99]\" data-kid=\"1-1-5-4-2-1\" data-name=\"building store icon box\">\n                        <span class=\"text-xl\" data-kid=\"1-1-5-4-2-1-1\" data-name=\"building store icon wrapper\">\n                            <i class=\"ti ti-building-store\" data-kid=\"1-1-5-4-2-1-1-1\" data-name=\"building store icon\">\n                            </i>\n                        </span>\n                    </div>\n                    <div data-kid=\"1-1-5-4-2-2\" data-name=\"feature text group\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-1-5-4-2-2-1\" data-name=\"feature title row with appendix badge\">\n                            <h2 class=\"text-[15px] font-bold text-white\" data-kid=\"1-1-5-4-2-2-1-1\" data-name=\"feature title text\">\n                                Tự động lập tờ khai Đăng ký Hộ kinh doanh\n                            </h2>\n                            <span class=\"px-2 py-0.5 rounded text-[11px] font-mono-code font-semibold bg-[#ecc15a]/20 text-[#f5d47a] border border-[#ecc15a]/30\" data-kid=\"1-1-5-4-2-2-1-2\" data-name=\"appendix form reference badge\">\n                                Phụ lục III-1\n                            </span>\n                        </div>\n                        <p class=\"text-[13.5px] text-white/80 mt-1 leading-relaxed\" data-kid=\"1-1-5-4-2-2-2\" data-name=\"feature description text\">\n                            Chuẩn hóa mã ngành kinh tế, vốn đăng ký và thông tin chủ hộ trước khi nộp trực tuyến lên UBND cấp huyện/xã.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- BOTTOM FOOTER: User-Controlled Architectural Slide Switcher (Replaces unpausable timer) -->\n        <footer class=\"relative z-10 pt-5 border-t border-white/12 flex flex-wrap items-center justify-between gap-4\" data-kid=\"1-1-6\" data-name=\"footer with slide caption and switcher controls\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-6-1\" data-name=\"slide caption group\">\n                <span class=\"text-xs text-[#f5d47a] font-semibold flex items-center gap-1.5\" data-kid=\"1-1-6-1-1\" data-name=\"slide caption with icon\">\n                    <span class=\"text-sm\" data-kid=\"1-1-6-1-1-1\" data-name=\"landmark building icon wrapper\">\n                        <i class=\"ti ti-building-bank\" data-kid=\"1-1-6-1-1-1-1\" data-name=\"landmark building icon\">\n                        </i>\n                    </span>\n                    <span data-dynamic=\"true\" data-kid=\"1-1-6-1-1-2\" data-name=\"current slide caption text\" data-reason=\"text replaced by selectSlide caption list on each slide change\" id=\"slide-caption\">\n                        Tòa nhà Quốc hội Việt Nam — Ba Đình, Hà Nội\n                    </span>\n                </span>\n            </div>\n            <div aria-label=\"Điều khiển ảnh nền kiến trúc\" class=\"flex items-center gap-2\" data-kid=\"1-1-6-2\" data-name=\"slide dot navigation group\" role=\"group\">\n                <button class=\"h-2.5 w-7 rounded-full bg-[#ecc15a] transition-all cursor-pointer\" data-dynamic=\"true\" data-kid=\"1-1-6-2-1\" data-name=\"active slide indicator dot\" data-reason=\"shape and color class swapped by selectSlide script\" id=\"dot-0\" onclick=\"selectSlide(0)\" title=\"Tòa nhà Quốc hội\" type=\"button\">\n                </button>\n                <button class=\"h-2.5 w-2.5 rounded-full bg-white/35 hover:bg-white/60 transition-all cursor-pointer\" data-dynamic=\"true\" data-kid=\"1-1-6-2-2\" data-name=\"inactive slide indicator dot\" data-reason=\"shape and color class swapped by selectSlide script\" id=\"dot-1\" onclick=\"selectSlide(1)\" title=\"Tòa án Nhân dân Hà Nội\" type=\"button\">\n                </button>\n                <button class=\"h-2.5 w-2.5 rounded-full bg-white/35 hover:bg-white/60 transition-all cursor-pointer\" data-dynamic=\"true\" data-kid=\"1-1-6-2-3\" data-name=\"inactive slide indicator dot\" data-reason=\"shape and color class swapped by selectSlide script\" id=\"dot-2\" onclick=\"selectSlide(2)\" title=\"Tòa án Nhân dân Tối cao\" type=\"button\">\n                </button>\n                <button class=\"h-2.5 w-2.5 rounded-full bg-white/35 hover:bg-white/60 transition-all cursor-pointer\" data-dynamic=\"true\" data-kid=\"1-1-6-2-4\" data-name=\"inactive slide indicator dot\" data-reason=\"shape and color class swapped by selectSlide script\" id=\"dot-3\" onclick=\"selectSlide(3)\" title=\"Tòa án Nhân dân TP.HCM\" type=\"button\">\n                </button>\n                <button class=\"ml-1.5 inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-white/10 hover:bg-white/20 border border-white/15 text-[11px] font-medium text-white/90 cursor-pointer\" data-kid=\"1-1-6-2-5\" data-name=\"slide pause toggle button\" id=\"slide-pause-btn\" onclick=\"toggleSlidePause()\" type=\"button\">\n                    <span class=\"text-xs\" data-kid=\"1-1-6-2-5-1\" data-name=\"pause icon wrapper\">\n                        <i class=\"ti ti-player-pause\" data-dynamic=\"true\" data-kid=\"1-1-6-2-5-1-1\" data-name=\"pause/play slide icon\" data-reason=\"class swapped between pause and play icons by toggleSlidePause\" id=\"slide-pause-icon\">\n                        </i>\n                    </span>\n                    <span data-dynamic=\"true\" data-kid=\"1-1-6-2-5-2\" data-name=\"pause/resume button label\" data-reason=\"text toggled between Tạm dừng and Tiếp tục by toggleSlidePause\" id=\"slide-pause-label\">\n                        Tạm dừng\n                    </span>\n                </button>\n            </div>\n        </footer>\n    </section>\n    <!-- RIGHT PANEL (40% Desktop): High-Contrast Solid Surface Auth Canvas -->\n    <section class=\"lg:w-[42%] xl:w-[40%] min-h-[900px] bg-[#F7F3EB] flex flex-col justify-between p-6 sm:p-10 xl:p-12 relative\" data-kid=\"1-2\" data-name=\"authentication right panel\">\n        <!-- Top Crimson & Gold Accent Bar -->\n        <div class=\"absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#b40006] via-[#da251d] to-[#c5931a]\" data-kid=\"1-2-1\" data-name=\"top crimson and gold accent bar\">\n        </div>\n        <!-- Prototype Interactive State Switcher Bar (For Engineer Inspection) -->\n        <div class=\"w-full max-w-[460px] mx-auto mb-4\" data-kid=\"1-2-2\" data-name=\"prototype state switcher bar\">\n            <div class=\"flex flex-wrap items-center justify-between gap-2 px-3 py-2 rounded-xl bg-[#EFE9DC] border border-[#DFD5C3] text-xs\" data-kid=\"1-2-2-1\" data-name=\"state switcher toolbar\">\n                <span class=\"font-semibold text-[#5d403b] flex items-center gap-1.5\" data-kid=\"1-2-2-1-1\" data-name=\"state display label\">\n                    <span class=\"text-sm text-[#b40006]\" data-kid=\"1-2-2-1-1-1\" data-name=\"eye preview icon wrapper\">\n                        <i class=\"ti ti-eye\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"eye preview icon\">\n                        </i>\n                    </span>\n                    Trạng thái hiển thị:\n                </span>\n                <div class=\"flex items-center gap-1\" data-kid=\"1-2-2-1-2\" data-name=\"state selection button group\">\n                    <button class=\"px-2.5 py-1 rounded-lg font-semibold bg-[#b40006] text-white shadow-2xs cursor-pointer transition\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-1\" data-name=\"logged out preview state button\" data-reason=\"active/inactive styling class rewritten by setPreviewState\" id=\"state-btn-loggedOut\" onclick=\"setPreviewState('loggedOut')\" type=\"button\">\n                        Đã đăng xuất\n                    </button>\n                    <button class=\"px-2.5 py-1 rounded-lg font-medium text-[#5d403b] hover:bg-white/60 cursor-pointer transition\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2\" data-name=\"error preview state button\" data-reason=\"active/inactive styling class rewritten by setPreviewState\" id=\"state-btn-error\" onclick=\"setPreviewState('error')\" type=\"button\">\n                        Báo lỗi trong Form\n                    </button>\n                    <button class=\"px-2.5 py-1 rounded-lg font-medium text-[#5d403b] hover:bg-white/60 cursor-pointer transition\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-3\" data-name=\"default preview state button\" data-reason=\"active/inactive styling class rewritten by setPreviewState\" id=\"state-btn-default\" onclick=\"setPreviewState('default')\" type=\"button\">\n                        Mặc định\n                    </button>\n                </div>\n            </div>\n        </div>\n        <!-- CRISP SOLID ELEVATED AUTH CARD (Replaces muddy gray glassmorphism) -->\n        <div class=\"w-full max-w-[460px] mx-auto my-auto bg-white rounded-2xl border border-[#E4DDD0] shadow-[0_12px_36px_rgba(45,18,12,0.08)] p-6 sm:p-8\" data-kid=\"1-2-3\" data-name=\"elevated login card container\">\n            <!-- Segmented Auth Tabs (Đăng nhập / Đăng ký) -->\n            <nav aria-label=\"Chuyển đổi Đăng nhập và Đăng ký\" class=\"grid grid-cols-2 gap-1.5 p-1.5 rounded-xl bg-[#F5F0E6] border border-[#E6DEC8] mb-6\" data-kid=\"1-2-3-1\" data-name=\"login/signup segmented tabs nav\">\n                <a aria-current=\"page\" class=\"flex items-center justify-center gap-2 h-10 rounded-lg bg-[#b40006] text-white text-[13.5px] font-bold shadow-xs\" data-kid=\"1-2-3-1-1\" data-name=\"active login tab link\" href=\"#login\">\n                    <span class=\"text-base\" data-kid=\"1-2-3-1-1-1\" data-name=\"login tab icon wrapper\">\n                        <i class=\"ti ti-login-2\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"login tab icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-2-3-1-1-2\" data-name=\"login tab label text\">\n                        Đăng nhập\n                    </span>\n                </a>\n                <a class=\"flex items-center justify-center gap-2 h-10 rounded-lg text-[#5d403b] hover:text-[#181312] hover:bg-white/60 text-[13.5px] font-semibold transition\" data-kid=\"1-2-3-1-2\" data-name=\"signup tab link\" href=\"#signup\">\n                    <span class=\"text-base\" data-kid=\"1-2-3-1-2-1\" data-name=\"signup tab icon wrapper\">\n                        <i class=\"ti ti-user-plus\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"signup tab icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-2-3-1-2-2\" data-name=\"signup tab label text\">\n                        Đăng ký tài khoản\n                    </span>\n                </a>\n            </nav>\n            <!-- BANNER 1: Signed-Out Confirmation State (?loggedOut=1) -->\n            <div class=\"mb-5 rounded-xl border border-emerald-200 bg-emerald-50/90 p-3.5 text-emerald-950 flex items-start gap-3\" data-dynamic=\"true\" data-kid=\"1-2-3-2\" data-name=\"signed out confirmation banner\" data-reason=\"hidden class toggled by setPreviewState depending on preview state\" id=\"banner-logged-out\" role=\"status\">\n                <div class=\"w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center shrink-0 mt-0.5\" data-kid=\"1-2-3-2-1\" data-name=\"shield check icon box\">\n                    <span class=\"text-lg\" data-kid=\"1-2-3-2-1-1\" data-name=\"shield check icon wrapper\">\n                        <i class=\"ti ti-shield-check\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"shield check icon\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"flex-1 min-w-0\" data-kid=\"1-2-3-2-2\" data-name=\"banner message group\">\n                    <div class=\"text-[13.5px] font-bold text-emerald-950\" data-kid=\"1-2-3-2-2-1\" data-name=\"banner heading text\">\n                        Đã đăng xuất khỏi hệ thống an toàn\n                    </div>\n                    <p class=\"text-xs text-emerald-800 mt-0.5 leading-relaxed\" data-kid=\"1-2-3-2-2-2\" data-name=\"banner description text\">\n                        Phiên làm việc và chứng chỉ truy cập trước đó đã được đóng. Vui lòng đăng nhập lại để tiếp tục giải quyết hồ sơ.\n                    </p>\n                </div>\n                <button aria-label=\"Đóng thông báo\" class=\"text-emerald-700 hover:text-emerald-950 p-1 rounded-md cursor-pointer\" data-kid=\"1-2-3-2-3\" data-name=\"close banner button\" onclick=\"document.getElementById('banner-logged-out').classList.add('hidden')\" type=\"button\">\n                    <span class=\"text-base\" data-kid=\"1-2-3-2-3-1\" data-name=\"close icon wrapper\">\n                        <i class=\"ti ti-x\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"close X icon\">\n                        </i>\n                    </span>\n                </button>\n            </div>\n            <!-- Header -->\n            <div class=\"mb-5\" data-kid=\"1-2-3-3\" data-name=\"login heading block\">\n                <h2 class=\"text-2xl font-bold text-[#181312] tracking-tight\" data-kid=\"1-2-3-3-1\" data-name=\"login heading title\">\n                    Đăng nhập hệ thống\n                </h2>\n                <p class=\"text-[13.5px] text-[#5d403b] mt-1\" data-kid=\"1-2-3-3-2\" data-name=\"login audience subtitle text\">\n                    Dành cho Công dân, Luật sư và Cán bộ Quản trị viên\n                </p>\n            </div>\n            <!-- Login Form -->\n            <form class=\"space-y-4\" data-kid=\"1-2-3-4\" data-name=\"login form\" id=\"login-form\" novalidate=\"\" onsubmit=\"handleDemoSubmit(event)\">\n                <!-- Updated Credential Field: Supports BOTH Email & Username -->\n                <div data-kid=\"1-2-3-4-1\" data-name=\"email or username field group\">\n                    <div class=\"flex items-center justify-between mb-1.5\" data-kid=\"1-2-3-4-1-1\" data-name=\"field label row\">\n                        <label class=\"block text-[13px] font-semibold text-[#181312]\" data-kid=\"1-2-3-4-1-1-1\" data-name=\"email or username label\" for=\"gov-identifier\">\n                            Email hoặc Tên đăng nhập\n                            <span class=\"text-[#b40006]\" data-kid=\"1-2-3-4-1-1-1-1\" data-name=\"required field asterisk\">\n                                *\n                            </span>\n                        </label>\n                        <span class=\"text-[11px] font-medium text-[#7A5B54] bg-[#FDF2F1] border border-[#F3D1CE] px-2 py-0.5 rounded-md\" data-kid=\"1-2-3-4-1-1-2\" data-name=\"civil/admin account hint badge\">\n                            Công dân / Admin\n                        </span>\n                    </div>\n                    <div class=\"relative\" data-kid=\"1-2-3-4-1-2\" data-name=\"input with side icon wrapper\">\n                        <div class=\"absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#7A5B54]\" data-kid=\"1-2-3-4-1-2-1\" data-name=\"leading user icon slot\">\n                            <span class=\"text-lg\" data-kid=\"1-2-3-4-1-2-1-1\" data-name=\"user icon wrapper\">\n                                <i class=\"ti ti-user-check\" data-kid=\"1-2-3-4-1-2-1-1-1\" data-name=\"user check icon\">\n                                </i>\n                            </span>\n                        </div>\n                        <input autocapitalize=\"none\" autocomplete=\"username\" class=\"w-full h-12 pl-10 pr-4 rounded-xl bg-[#FCFBF9] border border-[#D5CBB8] text-[#181312] text-[14.5px] font-medium placeholder:text-[#8E7F7A] focus:outline-none focus:bg-white focus:border-[#b40006] focus:ring-3 focus:ring-[#b40006]/15 transition\" data-kid=\"1-2-3-4-1-2-2\" data-name=\"email or username input field\" id=\"gov-identifier\" placeholder=\"Nhập email hoặc tên đăng nhập (vd: admin2026)\" required=\"\" spellcheck=\"false\" type=\"text\" value=\"admin2026\"/>\n                    </div>\n                    <p class=\"mt-1.5 text-[11.5px] text-[#6E5A54] flex items-center gap-1.5\" data-kid=\"1-2-3-4-1-3\" data-name=\"field helper explanation text\">\n                        <span class=\"text-xs text-[#8d6b02]\" data-kid=\"1-2-3-4-1-3-1\" data-name=\"info circle icon wrapper\">\n                            <i class=\"ti ti-info-circle\" data-kid=\"1-2-3-4-1-3-1-1\" data-name=\"info circle icon\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-2-3-4-1-3-2\" data-name=\"helper text with emphasized terms\">\n                            Nhập\n                            <strong data-kid=\"1-2-3-4-1-3-2-1\" data-name=\"emphasized Email keyword\">\n                                Email\n                            </strong>\n                            (tài khoản công dân/luật sư) hoặc\n                            <strong data-kid=\"1-2-3-4-1-3-2-2\" data-name=\"emphasized account code keyword\">\n                                Mã tài khoản\n                            </strong>\n                            (vd:\n                            <code class=\"font-mono-code text-[#b40006]\" data-kid=\"1-2-3-4-1-3-2-3\" data-name=\"example account code value\">\n                                admin2026\n                            </code>\n                            ).\n                        </span>\n                    </p>\n                </div>\n                <!-- Password Field -->\n                <div data-kid=\"1-2-3-4-2\" data-name=\"password field group\">\n                    <div class=\"flex items-center justify-between mb-1.5\" data-kid=\"1-2-3-4-2-1\" data-name=\"password label row\">\n                        <label class=\"block text-[13px] font-semibold text-[#181312]\" data-kid=\"1-2-3-4-2-1-1\" data-name=\"password label\" for=\"gov-password\">\n                            Mật khẩu\n                            <span class=\"text-[#b40006]\" data-kid=\"1-2-3-4-2-1-1-1\" data-name=\"required field asterisk\">\n                                *\n                            </span>\n                        </label>\n                        <a class=\"text-[13px] font-semibold text-[#b40006] hover:text-[#930004] hover:underline\" data-kid=\"1-2-3-4-2-1-2\" data-name=\"forgot password link\" href=\"#forgot-password\">\n                            Quên mật khẩu?\n                        </a>\n                    </div>\n                    <div class=\"relative\" data-kid=\"1-2-3-4-2-2\" data-name=\"password input with icon wrapper\">\n                        <div class=\"absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#7A5B54]\" data-kid=\"1-2-3-4-2-2-1\" data-name=\"leading lock icon slot\">\n                            <span class=\"text-lg\" data-kid=\"1-2-3-4-2-2-1-1\" data-name=\"lock icon wrapper\">\n                                <i class=\"ti ti-lock\" data-kid=\"1-2-3-4-2-2-1-1-1\" data-name=\"lock icon\">\n                                </i>\n                            </span>\n                        </div>\n                        <input autocomplete=\"current-password\" class=\"w-full h-12 pl-10 pr-12 rounded-xl bg-[#FCFBF9] border border-[#D5CBB8] text-[#181312] text-[14.5px] font-medium placeholder:text-[#8E7F7A] focus:outline-none focus:bg-white focus:border-[#b40006] focus:ring-3 focus:ring-[#b40006]/15 transition\" data-dynamic=\"true\" data-kid=\"1-2-3-4-2-2-2\" data-name=\"password input field\" data-reason=\"value and type mask replaced by togglePassword script when revealed\" id=\"gov-password\" placeholder=\"Nhập mật khẩu của bạn\" required=\"\" type=\"password\" value=\"••••••••••••\"/>\n                        <button aria-label=\"Hiện mật khẩu\" class=\"absolute inset-y-0 right-0 w-11 flex items-center justify-center text-[#6E5A54] hover:text-[#181312] rounded-r-xl cursor-pointer\" data-kid=\"1-2-3-4-2-2-3\" data-name=\"show/hide password toggle button\" id=\"togglePasswordBtn\" onclick=\"togglePassword()\" type=\"button\">\n                            <span class=\"text-lg\" data-kid=\"1-2-3-4-2-2-3-1\" data-name=\"eye toggle icon wrapper\">\n                                <i class=\"ti ti-eye\" data-dynamic=\"true\" data-kid=\"1-2-3-4-2-2-3-1-1\" data-name=\"eye/eye-off password icon\" data-reason=\"class swapped between eye and eye-off by togglePassword\" id=\"pwdToggleIcon\">\n                                </i>\n                            </span>\n                        </button>\n                    </div>\n                </div>\n                <!-- Remember Session Row -->\n                <div class=\"flex items-center justify-between pt-0.5\" data-kid=\"1-2-3-4-3\" data-name=\"remember me and security row\">\n                    <label class=\"inline-flex items-center gap-2.5 cursor-pointer select-none\" data-kid=\"1-2-3-4-3-1\" data-name=\"remember me checkbox group\">\n                        <input checked=\"\" class=\"w-4 h-4 rounded-xs accent-[#b40006] cursor-pointer\" data-kid=\"1-2-3-4-3-1-1\" data-name=\"remember me checkbox\" type=\"checkbox\"/>\n                        <span class=\"text-[13px] text-[#4A3B36] font-medium\" data-kid=\"1-2-3-4-3-1-2\" data-name=\"remember me label text\">\n                            Duy trì đăng nhập trên thiết bị tin cậy\n                        </span>\n                    </label>\n                    <span class=\"text-[11.5px] text-[#7A5B54] flex items-center gap-1\" data-kid=\"1-2-3-4-3-2\" data-name=\"secure cookie indicator\">\n                        <span class=\"text-xs text-emerald-700\" data-kid=\"1-2-3-4-3-2-1\" data-name=\"secure lock check icon wrapper\">\n                            <i class=\"ti ti-lock-check\" data-kid=\"1-2-3-4-3-2-1-1\" data-name=\"lock check icon\">\n                            </i>\n                        </span>\n                        Cookie bảo mật\n                    </span>\n                </div>\n                <!-- INLINE FORM ERROR ALERT (Placed directly inside the form above Submit, NOT below Google!) -->\n                <div class=\"hidden rounded-xl border border-[#F1B8B5] bg-[#FDF2F1] p-3.5 text-[#7F1115] flex items-start gap-2.5\" data-dynamic=\"true\" data-kid=\"1-2-3-4-4\" data-name=\"inline login error alert\" data-reason=\"hidden class toggled by setPreviewState depending on preview state\" id=\"form-error-alert\" role=\"alert\">\n                    <span class=\"text-lg text-[#b40006] shrink-0 mt-0.5\" data-kid=\"1-2-3-4-4-1\" data-name=\"alert circle icon wrapper\">\n                        <i class=\"ti ti-alert-circle-filled\" data-kid=\"1-2-3-4-4-1-1\" data-name=\"alert circle icon\">\n                        </i>\n                    </span>\n                    <div class=\"text-xs leading-relaxed\" data-kid=\"1-2-3-4-4-2\" data-name=\"error message group\">\n                        <div class=\"font-bold text-[#930004]\" data-kid=\"1-2-3-4-4-2-1\" data-name=\"error heading text\">\n                            Thông tin xác thực chưa chính xác\n                        </div>\n                        <div class=\"mt-0.5\" data-kid=\"1-2-3-4-4-2-2\" data-name=\"error detail text\" id=\"form-error-text\">\n                            Tên đăng nhập/email hoặc mật khẩu không đúng. Vui lòng kiểm tra lại hoặc chọn \"Quên mật khẩu?\".\n                        </div>\n                    </div>\n                </div>\n                <!-- Primary Submit Button -->\n                <div class=\"pt-1\" data-kid=\"1-2-3-4-5\" data-name=\"submit button wrapper\">\n                    <button class=\"w-full h-12 px-6 rounded-xl bg-gradient-to-r from-[#b40006] to-[#da251d] hover:from-[#930004] hover:to-[#b40006] text-white font-bold text-[15px] shadow-[0_6px_18px_rgba(180,0,6,0.26)] flex items-center justify-center gap-2 cursor-pointer transition\" data-kid=\"1-2-3-4-5-1\" data-name=\"primary login submit button\" id=\"login-submit-button\" type=\"submit\">\n                        <span data-dynamic=\"true\" data-kid=\"1-2-3-4-5-1-1\" data-name=\"login submit label\" data-reason=\"text swapped to 'Đang xác thực phiên...' during submit by handleDemoSubmit\" id=\"login-submit-label\">\n                            Đăng nhập vào hệ thống\n                        </span>\n                        <span class=\"text-lg\" data-kid=\"1-2-3-4-5-1-2\" data-name=\"arrow right icon wrapper\">\n                            <i class=\"ti ti-arrow-right\" data-kid=\"1-2-3-4-5-1-2-1\" data-name=\"arrow right icon\">\n                            </i>\n                        </span>\n                    </button>\n                </div>\n            </form>\n            <!-- Divider -->\n            <div aria-hidden=\"true\" class=\"relative my-5 flex items-center\" data-kid=\"1-2-3-5\" data-name=\"divider with label\">\n                <div class=\"grow border-t border-[#E6DEC8]\" data-kid=\"1-2-3-5-1\" data-name=\"divider line left\">\n                </div>\n                <span class=\"px-3 text-xs font-medium text-[#7A5B54] uppercase tracking-wider\" data-kid=\"1-2-3-5-2\" data-name=\"divider label text\">\n                    Hoặc đăng nhập nhanh\n                </span>\n                <div class=\"grow border-t border-[#E6DEC8]\" data-kid=\"1-2-3-5-3\" data-name=\"divider line right\">\n                </div>\n            </div>\n            <!-- Google Login Button -->\n            <div data-kid=\"1-2-3-6\" data-name=\"google login button wrapper\">\n                <button class=\"w-full h-12 px-5 rounded-xl bg-white hover:bg-[#FAF7F2] border border-[#D5CBB8] text-[#181312] font-semibold text-[14px] shadow-2xs flex items-center justify-center gap-3 cursor-pointer transition\" data-kid=\"1-2-3-6-1\" data-name=\"google login button\" id=\"google-login-button\" type=\"button\">\n                    <svg aria-hidden=\"true\" class=\"w-5 h-5 shrink-0\" data-kid=\"1-2-3-6-1-1\" data-name=\"google colored logo svg\" viewbox=\"0 0 48 48\">\n                        <path d=\"M43.6 24.5c0-1.4-.1-2.8-.4-4.1H24v7.8h11c-.5 2.5-1.9 4.7-4 6.1v5.1h6.5c3.8-3.5 6.1-8.7 6.1-14.9z\" fill=\"#4285F4\">\n                        </path>\n                        <path d=\"M24 44c5.5 0 10.1-1.8 13.5-4.8L31 34.1c-1.8 1.2-4.1 1.9-7 1.9-5.3 0-9.8-3.6-11.4-8.4H5.9v5.3C9.3 39.5 16.1 44 24 44z\" fill=\"#34A853\">\n                        </path>\n                        <path d=\"M12.6 27.6a12 12 0 0 1 0-7.2v-5.3H5.9a20 20 0 0 0 0 17.8l6.7-5.3z\" fill=\"#FBBC05\">\n                        </path>\n                        <path d=\"M24 12.1c3 0 5.7 1 7.8 3.1l5.8-5.8C34.1 6.1 29.5 4 24 4 16.1 4 9.3 8.5 5.9 15.1l6.7 5.3c1.6-4.8 6.1-8.3 11.4-8.3z\" fill=\"#EA4335\">\n                        </path>\n                    </svg>\n                    <span data-kid=\"1-2-3-6-1-2\" data-name=\"google login button label\">\n                        Đăng nhập bằng tài khoản Google\n                    </span>\n                </button>\n            </div>\n            <!-- Bottom Switch to Signup -->\n            <div class=\"mt-6 pt-4 border-t border-[#EFE9DC] flex items-center justify-center gap-1.5 text-[13.5px] text-[#5d403b]\" data-kid=\"1-2-3-7\" data-name=\"bottom signup switch row\">\n                <span data-kid=\"1-2-3-7-1\" data-name=\"signup prompt text\">\n                    Chưa có tài khoản công dân?\n                </span>\n                <a class=\"font-bold text-[#b40006] hover:underline\" data-kid=\"1-2-3-7-2\" data-name=\"signup call-to-action link\" href=\"#signup\">\n                    Đăng ký ngay\n                </a>\n            </div>\n        </div>\n        <!-- Bottom Support & Security Footer -->\n        <div class=\"w-full max-w-[460px] mx-auto mt-4 flex flex-wrap items-center justify-between gap-2 text-xs text-[#6E5A54]\" data-kid=\"1-2-4\" data-name=\"bottom support and security footer\">\n            <div class=\"flex items-center gap-1.5\" data-kid=\"1-2-4-1\" data-name=\"support hotline group\">\n                <span class=\"text-sm text-[#b40006]\" data-kid=\"1-2-4-1-1\" data-name=\"headset support icon wrapper\">\n                    <i class=\"ti ti-headset\" data-kid=\"1-2-4-1-1-1\" data-name=\"headset support icon\">\n                    </i>\n                </span>\n                <span data-kid=\"1-2-4-1-2\" data-name=\"support hotline text group\">\n                    Tổng đài hỗ trợ:\n                    <strong class=\"text-[#181312]\" data-kid=\"1-2-4-1-2-1\" data-name=\"support hotline number\">\n                        1800 1096\n                    </strong>\n                    (Miễn phí)\n                </span>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-4-2\" data-name=\"security links group\">\n                <a class=\"hover:text-[#b40006] underline-offset-2 hover:underline\" data-kid=\"1-2-4-2-1\" data-name=\"guide link\" href=\"#huong-dan\">\n                    Hướng dẫn\n                </a>\n                <span data-kid=\"1-2-4-2-2\" data-name=\"link separator bullet\">\n                    •\n                </span>\n                <a class=\"hover:text-[#b40006] underline-offset-2 hover:underline\" data-kid=\"1-2-4-2-3\" data-name=\"security link\" href=\"#bao-mat\">\n                    Bảo mật\n                </a>\n            </div>\n        </div>\n    </section>\n</div>\n<script>\n    const captions = [\n    'Tòa nhà Quốc hội Việt Nam — Ba Đình, Hà Nội',\n    'Trụ sở Tòa án Nhân dân TP. Hà Nội',\n    'Trụ sở Tòa án Nhân dân Tối cao',\n    'Tòa án Nhân dân TP. Hồ Chí Minh'\n  ];\n  let currentSlide = 0;\n  let paused = false;\n\n  function selectSlide(index) {\n    currentSlide = index;\n    for (let i = 0; i < 4; i++) {\n      const slide = document.getElementById('slide-' + i);\n      const dot = document.getElementById('dot-' + i);\n      if (slide) slide.style.opacity = i === index ? '1' : '0';\n      if (dot) {\n        dot.className = i === index\n          ? 'h-2.5 w-7 rounded-full bg-[#ecc15a] transition-all cursor-pointer'\n          : 'h-2.5 w-2.5 rounded-full bg-white/35 hover:bg-white/60 transition-all cursor-pointer';\n      }\n    }\n    const captionEl = document.getElementById('slide-caption');\n    if (captionEl) captionEl.textContent = captions[index];\n  }\n\n  function toggleSlidePause() {\n    paused = !paused;\n    const icon = document.getElementById('slide-pause-icon');\n    const label = document.getElementById('slide-pause-label');\n    if (icon) icon.className = paused ? 'ti ti-player-play' : 'ti ti-player-pause';\n    if (label) label.textContent = paused ? 'Tiếp tục' : 'Tạm dừng';\n  }\n\n  function togglePassword() {\n    const input = document.getElementById('gov-password');\n    const icon = document.getElementById('pwdToggleIcon');\n    if (!input || !icon) return;\n    const isPassword = input.type === 'password';\n    input.type = isPassword ? 'text' : 'password';\n    if (isPassword && input.value === '••••••••••••') {\n      input.value = 'Admin@2026';\n    }\n    icon.className = isPassword ? 'ti ti-eye-off' : 'ti ti-eye';\n  }\n\n  function setPreviewState(state) {\n    const loggedOutBanner = document.getElementById('banner-logged-out');\n    const errorAlert = document.getElementById('form-error-alert');\n    const states = ['loggedOut', 'error', 'default'];\n\n    states.forEach((s) => {\n      const btn = document.getElementById('state-btn-' + s);\n      if (!btn) return;\n      if (s === state) {\n        btn.className = 'px-2.5 py-1 rounded-lg font-semibold bg-[#b40006] text-white shadow-2xs cursor-pointer transition';\n      } else {\n        btn.className = 'px-2.5 py-1 rounded-lg font-medium text-[#5d403b] hover:bg-white/60 cursor-pointer transition';\n      }\n    });\n\n    if (loggedOutBanner) loggedOutBanner.classList.toggle('hidden', state !== 'loggedOut');\n    if (errorAlert) errorAlert.classList.toggle('hidden', state !== 'error');\n  }\n\n  function handleDemoSubmit(e) {\n    e.preventDefault();\n    const btn = document.getElementById('login-submit-label');\n    if (btn) btn.textContent = 'Đang xác thực phiên...';\n    setTimeout(() => {\n      if (btn) btn.textContent = 'Đăng nhập vào hệ thống';\n    }, 900);\n  }\n</script>\n",
      "comments": [],
      "created": "2026-10-19T02:23:34.655216+00:00",
      "modified": "2026-10-19T02:23:40.947268+00:00",
