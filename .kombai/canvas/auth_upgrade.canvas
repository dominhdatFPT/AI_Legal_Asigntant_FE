      "contentHeight": 1047
    },
    "var_6df161b98bc3": {
      "type": "variant",
      "label": "2. Giao diện Đăng xuất (Menu Tài khoản & Hộp thoại Xác nhận Đăng xuất)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n\n  @layer base {\n    body {\n      margin: 0;\n      font-family: 'Be Vietnam Pro', sans-serif;\n      background-color: #f8f5ee;\n      color: #1c1917;\n    }\n  }\n\n  @keyframes spin-slow {\n    from { transform: rotate(0deg); }\n    to { transform: rotate(360deg); }\n  }\n\n  .animate-spin-custom {\n    animation: spin-slow 0.9s linear infinite;\n  }\n</style>\n<div class=\"min-h-[960px] w-full bg-[#f6f3ec] text-[#1c1917] flex flex-col select-none\" data-kid=\"1\" data-name=\"logout showcase page wrapper\" id=\"logout-showcase-root\">\n    <!-- TOP INTERACTIVE CONTROL BAR (Context & State Switcher) -->\n    <div class=\"w-full bg-[#1e1615] text-white border-b border-[#ecc15a]/25 px-6 py-3 flex flex-wrap items-center justify-between gap-4 z-50\" data-kid=\"1-1\" data-name=\"top control bar\">\n        <div class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"brand and context label\">\n            <span class=\"inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[#b40006] text-[#ecc15a] border border-[#ecc15a]/40 shadow-xs\" data-kid=\"1-1-1-1\" data-name=\"shield lock brand badge\">\n                <i class=\"ti ti-shield-lock text-lg\" data-kid=\"1-1-1-1-1\" data-name=\"shield lock icon\">\n                </i>\n            </span>\n            <div data-kid=\"1-1-1-2\" data-name=\"context heading and description\">\n                <div class=\"text-xs font-semibold uppercase tracking-wider text-[#ecc15a]\" data-kid=\"1-1-1-2-1\" data-name=\"context title text\">\n                    Bản nâng cấp UI/UX • Luồng Đăng xuất & Quản lý Phiên\n                </div>\n                <div class=\"text-xs text-stone-300\" data-kid=\"1-1-1-2-2\" data-name=\"context subtitle text\">\n                    Đồng bộ hệ màu Đỏ son (#b40006) & Vàng đồng (#ecc15a) • Loại bỏ hộp thoại confirm() trình duyệt\n                </div>\n            </div>\n        </div>\n        <!-- Interactive Switchers -->\n        <div class=\"flex flex-wrap items-center gap-3\" data-kid=\"1-1-2\" data-name=\"interactive switcher group\">\n            <!-- Context Switcher -->\n            <div aria-label=\"Chọn giao diện\" class=\"inline-flex items-center bg-black/40 p-1 rounded-xl border border-white/10\" data-kid=\"1-1-2-1\" data-name=\"citizen vs admin context switcher\" role=\"group\">\n                <button class=\"px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 bg-[#da251d] text-white shadow-xs cursor-pointer\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1\" data-name=\"citizen context button\" data-reason=\"entire class list overwritten by updateUI on every context switch for active state\" id=\"ctx-citizen-btn\" onclick=\"switchContext('citizen')\" type=\"button\">\n                    <i class=\"ti ti-user-check text-sm\" data-kid=\"1-1-2-1-1-1\" data-name=\"authenticated user icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-1-1-2\" data-name=\"context button label\">\n                        1. Cổng Công dân / Luật sư (Header)\n                    </span>\n                </button>\n                <button class=\"px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 text-stone-300 hover:text-white cursor-pointer\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2\" data-name=\"admin context button\" data-reason=\"entire class list overwritten by updateUI on every context switch for active state\" id=\"ctx-admin-btn\" onclick=\"switchContext('admin')\" type=\"button\">\n                    <i class=\"ti ti-layout-sidebar text-sm\" data-kid=\"1-1-2-1-2-1\" data-name=\"layout sidebar icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-1-2-2\" data-name=\"context button label\">\n                        2. Cổng Quản trị viên (Sidebar + Header)\n                    </span>\n                </button>\n            </div>\n            <div class=\"h-5 w-px bg-white/15 hidden sm:block\" data-kid=\"1-1-2-2\" data-name=\"vertical divider\">\n            </div>\n            <!-- State Switcher -->\n            <div aria-label=\"Chọn trạng thái\" class=\"inline-flex items-center bg-black/40 p-1 rounded-xl border border-white/10\" data-kid=\"1-1-2-3\" data-name=\"logout state switcher\" role=\"group\">\n                <button class=\"px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-stone-300 hover:text-white cursor-pointer\" data-dynamic=\"true\" data-kid=\"1-1-2-3-1\" data-name=\"menu state button\" data-reason=\"entire class list overwritten by updateUI on every state switch for active state\" id=\"state-menu-btn\" onclick=\"switchState('menu')\" type=\"button\">\n                    Menu Tài khoản mở\n                </button>\n                <button class=\"px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-[#ecc15a] text-[#251a00] shadow-xs cursor-pointer\" data-dynamic=\"true\" data-kid=\"1-1-2-3-2\" data-name=\"modal state button\" data-reason=\"entire class list overwritten by updateUI on every state switch for active state\" id=\"state-modal-btn\" onclick=\"switchState('modal')\" type=\"button\">\n                    Hộp thoại Xác nhận (Modal)\n                </button>\n                <button class=\"px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-stone-300 hover:text-white cursor-pointer\" data-dynamic=\"true\" data-kid=\"1-1-2-3-3\" data-name=\"loading state button\" data-reason=\"entire class list overwritten by updateUI on every state switch for active state\" id=\"state-loading-btn\" onclick=\"switchState('loading')\" type=\"button\">\n                    Đang đóng phiên...\n                </button>\n            </div>\n        </div>\n    </div>\n    <!-- ===================================================================== -->\n    <!-- WORKSPACE STAGE (Renders Citizen or Admin Layout + Active Logout UI) -->\n    <!-- ===================================================================== -->\n    <div class=\"relative flex-1 w-full overflow-hidden flex flex-col\" data-kid=\"1-2\" data-name=\"workspace stage\">\n        <!-- =============================================================== -->\n        <!-- CONTEXT A: CITIZEN / LAWYER PORTAL (TOP HEADER + ACCOUNT VIEW)  -->\n        <!-- =============================================================== -->\n        <div class=\"w-full flex-1 flex flex-col\" data-dynamic=\"true\" data-kid=\"1-2-1\" data-name=\"citizen portal view\" data-reason=\"visibility (hidden/flex) toggled by updateUI on context change\" id=\"view-citizen\">\n            <!-- Upgraded National Public Service Header -->\n            <header class=\"w-full z-30 shadow-md\" data-kid=\"1-2-1-1\" data-name=\"citizen header\">\n                <!-- Top Crimson & Gold Brand Bar -->\n                <div class=\"h-18 bg-gradient-to-r from-[#6e0d16] via-[#b40006] to-[#930004] border-b border-[#ecc15a]/25\" data-kid=\"1-2-1-1-1\" data-name=\"crimson gold brand bar\">\n                    <div class=\"max-w-7xl mx-auto h-full px-8 flex items-center justify-between text-white\" data-kid=\"1-2-1-1-1-1\" data-name=\"brand bar inner layout\">\n                        <!-- Brand Identity -->\n                        <div class=\"flex items-center gap-3.5\" data-kid=\"1-2-1-1-1-1-1\" data-name=\"brand identity block\">\n                            <div class=\"w-11 h-11 rounded-full bg-white p-0.5 ring-2 ring-[#ecc15a]/70 shadow-sm flex items-center justify-center shrink-0\" data-kid=\"1-2-1-1-1-1-1-1\" data-name=\"logo circular badge\">\n                                <img alt=\"Logo Cổng Dịch vụ công Quốc gia\" class=\"w-full h-full object-contain rounded-full\" data-kid=\"1-2-1-1-1-1-1-1-1\" data-name=\"national service logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/AI_Legal/public/images/national-service-logo.png\"/>\n                            </div>\n                            <div class=\"flex flex-col\" data-kid=\"1-2-1-1-1-1-1-2\" data-name=\"brand text block\">\n                                <span class=\"text-base font-bold tracking-wide uppercase text-white leading-tight\" data-kid=\"1-2-1-1-1-1-1-2-1\" data-name=\"brand primary name\">\n                                    Cổng Trợ lý Pháp lý & Dịch vụ công\n                                </span>\n                                <span class=\"text-[11px] font-medium text-[#ffdf99] uppercase tracking-wider mt-0.5\" data-kid=\"1-2-1-1-1-1-1-2-2\" data-name=\"brand secondary description\">\n                                    Hệ thống thông tin giải quyết thủ tục Đất đai & Hộ kinh doanh\n                                </span>\n                            </div>\n                        </div>\n                        <!-- Right User Controls: Notification + Account Dropdown Trigger + Direct Logout Button -->\n                        <div class=\"flex items-center gap-3 relative\" data-kid=\"1-2-1-1-1-1-2\" data-name=\"right side user controls\">\n                            <!-- Help & Notification Buttons (42px touch target floor) -->\n                            <button class=\"w-10.5 h-10.5 rounded-xl bg-white/10 hover:bg-white/20 border border-white/15 flex items-center justify-center text-white transition-colors cursor-pointer\" data-kid=\"1-2-1-1-1-1-2-1\" data-name=\"notification bell button\" title=\"Thông báo hệ thống\" type=\"button\">\n                                <span class=\"relative flex items-center justify-center text-lg\" data-kid=\"1-2-1-1-1-1-2-1-1\" data-name=\"notification icon wrapper\">\n                                    <i class=\"ti ti-bell\" data-kid=\"1-2-1-1-1-1-2-1-1-1\" data-name=\"bell icon\">\n                                    </i>\n                                    <span class=\"absolute -top-1 -right-1 w-2 h-2 rounded-full bg-[#ecc15a]\" data-kid=\"1-2-1-1-1-1-2-1-1-2\" data-name=\"notification indicator dot\">\n                                    </span>\n                                </span>\n                            </button>\n                            <!-- Account Trigger Pill (Opens Dropdown Menu) -->\n                            <div class=\"relative\" data-kid=\"1-2-1-1-1-1-2-2\" data-name=\"account dropdown container\">\n                                <button class=\"h-11 pl-2.5 pr-3.5 rounded-xl bg-black/25 hover:bg-black/35 border border-[#ecc15a]/45 flex items-center gap-2.5 transition-all cursor-pointer shadow-xs\" data-kid=\"1-2-1-1-1-1-2-2-1\" data-name=\"account trigger button\" id=\"citizen-account-trigger\" onclick=\"switchState('menu')\" type=\"button\">\n                                    <div class=\"w-8 h-8 rounded-lg bg-gradient-to-br from-[#ecc15a] to-[#d4a12a] text-[#251a00] font-bold text-xs flex items-center justify-center shadow-xs shrink-0\" data-kid=\"1-2-1-1-1-1-2-2-1-1\" data-name=\"avatar initials badge\">\n                                        VA\n                                    </div>\n                                    <div class=\"flex flex-col text-left\" data-kid=\"1-2-1-1-1-1-2-2-1-2\" data-name=\"account info block\">\n                                        <div class=\"flex items-center gap-1.5\" data-kid=\"1-2-1-1-1-1-2-2-1-2-1\" data-name=\"account name row\">\n                                            <span class=\"text-xs font-bold text-white leading-tight\" data-kid=\"1-2-1-1-1-1-2-2-1-2-1-1\" data-name=\"citizen name text\" data-user-field=\"name\">\n                                                Nguyễn Văn An\n                                            </span>\n                                            <span class=\"inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-semibold bg-emerald-500/25 text-emerald-200 border border-emerald-400/30\" data-kid=\"1-2-1-1-1-1-2-2-1-2-1-2\" data-name=\"verified badge\">\n                                                Đã xác thực CCCD\n                                            </span>\n                                        </div>\n                                        <span class=\"text-[11px] text-[#ffdf99] leading-tight mt-0.5\" data-kid=\"1-2-1-1-1-1-2-2-1-2-2\" data-name=\"role and ID text\" data-user-field=\"role\">\n                                            Công dân • 079099******\n                                        </span>\n                                    </div>\n                                    <span class=\"text-[#ffdf99] text-base ml-1\" data-kid=\"1-2-1-1-1-1-2-2-1-3\" data-name=\"chevron wrapper\">\n                                        <i class=\"ti ti-chevron-down\" data-kid=\"1-2-1-1-1-1-2-2-1-3-1\" data-name=\"chevron down icon\">\n                                        </i>\n                                    </span>\n                                </button>\n                                <!-- CITIZEN ACCOUNT DROPDOWN MENU (Visible when state == 'menu') -->\n                                <div class=\"hidden absolute right-0 top-[calc(100%+10px)] w-80 rounded-2xl bg-white text-[#1c1917] shadow-[0_20px_50px_rgba(28,25,23,0.28)] border border-stone-200 overflow-hidden z-40\" data-dynamic=\"true\" data-kid=\"1-2-1-1-1-1-2-2-2\" data-name=\"citizen dropdown menu\" data-reason=\"hidden class toggled by updateUI based on state\" id=\"citizen-dropdown-menu\">\n                                    <!-- Header in Dropdown -->\n                                    <div class=\"p-4 bg-gradient-to-br from-[#fdf2f1] to-[#fff8f5] border-b border-stone-200/80\" data-kid=\"1-2-1-1-1-1-2-2-2-1\" data-name=\"dropdown header\">\n                                        <div class=\"flex items-start gap-3\" data-kid=\"1-2-1-1-1-1-2-2-2-1-1\" data-name=\"header inner layout\">\n                                            <div class=\"w-11 h-11 rounded-xl bg-[#b40006] text-white font-bold text-sm flex items-center justify-center shrink-0 shadow-xs\" data-kid=\"1-2-1-1-1-1-2-2-2-1-1-1\" data-name=\"dropdown avatar badge\">\n                                                VA\n                                            </div>\n                                            <div class=\"min-w-0 flex-1\" data-kid=\"1-2-1-1-1-1-2-2-2-1-1-2\" data-name=\"dropdown identity block\">\n                                                <div class=\"text-sm font-bold text-stone-900 truncate\" data-kid=\"1-2-1-1-1-1-2-2-2-1-1-2-1\" data-name=\"dropdown name text\">\n                                                    Nguyễn Văn An\n                                                </div>\n                                                <div class=\"text-xs text-stone-600 truncate\" data-kid=\"1-2-1-1-1-1-2-2-2-1-1-2-2\" data-name=\"dropdown email text\">\n                                                    an.nguyen.congdan@gmail.com\n                                                </div>\n                                                <div class=\"mt-1.5 inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-emerald-50 border border-emerald-200 text-emerald-800 text-[11px] font-semibold\" data-kid=\"1-2-1-1-1-1-2-2-2-1-1-2-3\" data-name=\"session security badge\">\n                                                    <i class=\"ti ti-shield-check text-xs\" data-kid=\"1-2-1-1-1-1-2-2-2-1-1-2-3-1\" data-name=\"shield check icon\">\n                                                    </i>\n                                                    <span data-kid=\"1-2-1-1-1-1-2-2-2-1-1-2-3-2\" data-name=\"session badge text\">\n                                                        Phiên bảo mật Cookie HttpOnly\n                                                    </span>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <!-- Menu Links -->\n                                    <div class=\"p-2 flex flex-col gap-0.5 text-sm\" data-kid=\"1-2-1-1-1-1-2-2-2-2\" data-name=\"dropdown menu links\">\n                                        <div class=\"px-3 py-1.5 text-[11px] font-bold uppercase tracking-wider text-stone-400\" data-kid=\"1-2-1-1-1-1-2-2-2-2-1\" data-name=\"menu section label\">\n                                            Tài khoản & Hồ sơ\n                                        </div>\n                                        <button class=\"w-full px-3 py-2.5 rounded-xl hover:bg-stone-100 flex items-center justify-between text-stone-800 font-medium transition-colors text-left\" data-kid=\"1-2-1-1-1-1-2-2-2-2-2\" data-name=\"account info menu item\" type=\"button\">\n                                            <span class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-1-1-1-2-2-2-2-2-1\" data-name=\"menu item left side\">\n                                                <span class=\"w-8 h-8 rounded-lg bg-red-50 text-[#b40006] flex items-center justify-center text-base\" data-kid=\"1-2-1-1-1-1-2-2-2-2-2-1-1\" data-name=\"icon container\">\n                                                    <i class=\"ti ti-id\" data-kid=\"1-2-1-1-1-1-2-2-2-2-2-1-1-1\" data-name=\"ID card icon\">\n                                                    </i>\n                                                </span>\n                                                <span data-kid=\"1-2-1-1-1-1-2-2-2-2-2-1-2\" data-name=\"menu item text block\">\n                                                    <span class=\"block text-xs font-semibold text-stone-900\" data-kid=\"1-2-1-1-1-1-2-2-2-2-2-1-2-1\" data-name=\"menu item title\">\n                                                        Thông tin tài khoản & CCCD\n                                                    </span>\n                                                    <span class=\