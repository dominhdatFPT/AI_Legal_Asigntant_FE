me=\"modal top accent bar\">\n                </div>\n                <div class=\"p-6 sm:p-7\" data-kid=\"1-2-3-1-2\" data-name=\"modal content\">\n                    <!-- Modal Header with Emblem & Close Button -->\n                    <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-2-3-1-2-1\" data-name=\"modal header\">\n                        <div class=\"flex items-center gap-3.5\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"modal header left block\">\n                            <div class=\"w-12 h-12 rounded-2xl bg-[#fff1f0] border border-[#ffdad5] text-[#b40006] flex items-center justify-center shrink-0 shadow-2xs\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"modal header icon\">\n                                <i class=\"ti ti-logout text-2xl\" data-kid=\"1-2-3-1-2-1-1-1-1\" data-name=\"logout icon\">\n                                </i>\n                            </div>\n                            <div data-kid=\"1-2-3-1-2-1-1-2\" data-name=\"modal header text block\">\n                                <span class=\"inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-wider text-[#930004]\" data-kid=\"1-2-3-1-2-1-1-2-1\" data-name=\"security label\">\n                                    <i class=\"ti ti-shield-lock text-xs\" data-kid=\"1-2-3-1-2-1-1-2-1-1\" data-name=\"shield lock icon\">\n                                    </i>\n                                    Bảo mật phiên làm việc\n                                </span>\n                                <h2 class=\"text-xl font-bold text-stone-900 leading-snug mt-0.5\" data-kid=\"1-2-3-1-2-1-1-2-2\" data-name=\"modal title\" id=\"logout-modal-title\">\n                                    Xác nhận đăng xuất?\n                                </h2>\n                            </div>\n                        </div>\n                        <button aria-label=\"Đóng hộp thoại\" class=\"w-9 h-9 rounded-xl text-stone-400 hover:text-stone-700 hover:bg-stone-100 flex items-center justify-center transition-colors cursor-pointer\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"modal close button\" onclick=\"switchState('menu')\" type=\"button\">\n                            <i class=\"ti ti-x text-lg\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"X close icon\">\n                            </i>\n                        </button>\n                    </div>\n                    <!-- Active Session Summary Card inside Modal -->\n                    <div class=\"mt-5 p-4 rounded-xl bg-[#faf6f0] border border-[#e9dec9] flex items-center justify-between gap-3\" data-kid=\"1-2-3-1-2-2\" data-name=\"modal session summary card\">\n                        <div class=\"flex items-center gap-3 min-w-0\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"session user info block\">\n                            <div class=\"w-11 h-11 rounded-xl bg-gradient-to-br from-[#b40006] to-[#8a1538] text-white font-bold text-sm flex items-center justify-center shrink-0 shadow-xs\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"modal user avatar\" data-reason=\"text replaced by updateUI based on context\" id=\"modal-user-avatar\">\n                                VA\n                            </div>\n                            <div class=\"min-w-0\" data-kid=\"1-2-3-1-2-2-1-2\" data-name=\"modal user details\">\n                                <div class=\"flex items-center gap-2\" data-kid=\"1-2-3-1-2-2-1-2-1\" data-name=\"modal user name row\">\n                                    <span class=\"text-sm font-bold text-stone-900 truncate\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-1-2-1-1\" data-name=\"modal user name text\" data-reason=\"text replaced by updateUI based on context\" id=\"modal-user-name\">\n                                        Nguyễn Văn An\n                                    </span>\n                                    <span class=\"px-2 py-0.5 rounded-md bg-[#ffdf99] text-[#5a4300] text-[11px] font-bold\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-1-2-1-2\" data-name=\"modal user role badge\" data-reason=\"text replaced by updateUI based on context\" id=\"modal-user-role-badge\">\n                                        Công dân\n                                    </span>\n                                </div>\n                                <div class=\"text-xs text-stone-600 truncate mt-0.5\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-1-2-2\" data-name=\"modal user identifier text\" data-reason=\"text replaced by updateUI based on context\" id=\"modal-user-identifier\">\n                                    an.nguyen.congdan@gmail.com\n                                </div>\n                            </div>\n                        </div>\n                        <span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-[11px] font-semibold shrink-0\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"active status badge\">\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-600\" data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"status dot\">\n                            </span>\n                            Đang hoạt động\n                        </span>\n                    </div>\n                    <!-- Clear What-Happens Explanation (Replaces generic confirm text) -->\n                    <div class=\"mt-4 space-y-2.5 text-xs text-stone-600 leading-relaxed\" data-kid=\"1-2-3-1-2-3\" data-name=\"logout explanation block\">\n                        <p class=\"text-sm text-stone-700 font-medium\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"explanation intro paragraph\">\n                            Bạn sắp kết thúc phiên làm việc trên\n                            <strong class=\"text-stone-900\" data-kid=\"1-2-3-1-2-3-1-1\" data-name=\"explanation site name emphasis\">\n                                Cổng Trợ lý Pháp lý & Dịch vụ công\n                            </strong>\n                            :\n                        </p>\n                        <ul class=\"space-y-2 bg-stone-50 p-3.5 rounded-xl border border-stone-200/80\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"actions list\">\n                            <li class=\"flex items-start gap-2\" data-kid=\"1-2-3-1-2-3-2-1\" data-name=\"session revocation list item\">\n                                <i class=\"ti ti-circle-check text-emerald-700 text-sm mt-0.5 shrink-0\" data-kid=\"1-2-3-1-2-3-2-1-1\" data-name=\"circle check icon\">\n                                </i>\n                                <span data-kid=\"1-2-3-1-2-3-2-1-2\" data-name=\"session revocation text\">\n                                    Thu hồi mã phiên (\n                                    <code class=\"text-[11px] font-semibold text-stone-800\" data-kid=\"1-2-3-1-2-3-2-1-2-1\" data-name=\"logout endpoint code\">\n                                        POST /api/users/auth/logout\n                                    </code>\n                                    ) và đăng xuất khỏi Firebase an toàn.\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-2\" data-kid=\"1-2-3-1-2-3-2-2\" data-name=\"draft preservation list item\">\n                                <i class=\"ti ti-device-floppy text-[#8d6b02] text-sm mt-0.5 shrink-0\" data-kid=\"1-2-3-1-2-3-2-2-1\" data-name=\"device floppy icon\">\n                                </i>\n                                <span data-kid=\"1-2-3-1-2-3-2-2-2\" data-name=\"draft preservation text\">\n                                    Các hồ sơ nháp và thông tin Căn cước công dân đã lưu vẫn được bảo toàn cho lần đăng nhập tiếp theo.\n                                </span>\n                            </li>\n                        </ul>\n                    </div>\n                    <!-- Loading / Revoking State Banner (Shown when state === 'loading') -->\n                    <div class=\"hidden mt-4 p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-950 flex items-center gap-3\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-4\" data-name=\"loading state banner\" data-reason=\"hidden class toggled by updateUI based on state\" id=\"modal-loading-banner\">\n                        <span class=\"w-5 h-5 rounded-full border-2 border-amber-300 border-t-[#b40006] animate-spin-custom shrink-0\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-4-1\" data-name=\"spinner icon\" data-reason=\"visibility class toggled by updateUI based on state\">\n                        </span>\n                        <div class=\"text-xs\" data-kid=\"1-2-3-1-2-4-2\" data-name=\"loading text block\">\n                            <div class=\"font-bold text-stone-900\" data-kid=\"1-2-3-1-2-4-2-1\" data-name=\"loading heading\">\n                                Đang thu hồi phiên xác thực & xóa cookie bảo mật...\n                            </div>\n                            <div class=\"text-stone-600 mt-0.5\" data-kid=\"1-2-3-1-2-4-2-2\" data-name=\"loading description\">\n                                Đang chuyển hướng an toàn về\n                                <span class=\"font-semibold text-[#b40006]\" data-kid=\"1-2-3-1-2-4-2-2-1\" data-name=\"login redirect link emphasis\">\n                                    /login?loggedOut=1\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <!-- Modal Action Buttons (Minimum 48px height, clear visual hierarchy) -->\n                    <div class=\"mt-6 flex flex-col-reverse sm:flex-row items-center justify-end gap-3\" data-kid=\"1-2-3-1-2-5\" data-name=\"modal action buttons row\">\n                        <button class=\"w-full sm:w-auto flex-1 h-12 px-5 rounded-xl bg-white hover:bg-stone-100 text-stone-800 border border-stone-300 font-semibold text-sm transition-colors flex items-center justify-center gap-2 cursor-pointer\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-5-1\" data-name=\"modal cancel button\" data-reason=\"disabled attribute toggled by updateUI based on state\" id=\"modal-cancel-btn\" onclick=\"switchState('menu')\" type=\"button\">\n                            <span data-kid=\"1-2-3-1-2-5-1-1\" data-name=\"cancel button label\">\n                                Ở lại trang\n                            </span>\n                        </button>\n                        <button class=\"w-full sm:w-auto flex-1 h-12 px-5 rounded-xl bg-[#b40006] hover:bg-[#930004] text-white font-semibold text-sm shadow-[0_6px_20px_rgba(180,0,6,0.28)] transition-all flex items-center justify-center gap-2 cursor-pointer\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-5-2\" data-name=\"modal confirm button\" data-reason=\"disabled, opacity and cursor-wait classes toggled by updateUI based on state\" id=\"modal-confirm-btn\" onclick=\"switchState('loading')\" type=\"button\">\n                            <span class=\"hidden w-4 h-4 rounded-full border-2 border-white/40 border-t-white animate-spin-custom\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-5-2-1\" data-name=\"confirm button spinner\" data-reason=\"visibility class toggled by updateUI based on state\" id=\"modal-confirm-spinner\">\n                            </span>\n                            <span data-dynamic=\"true\" data-kid=\"1-2-3-1-2-5-2-2\" data-name=\"confirm button label\" data-reason=\"text replaced by updateUI between confirm and loading states\" id=\"modal-confirm-label\">\n                                Xác nhận đăng xuất\n                            </span>\n                            <i class=\"ti ti-logout text-base\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-5-2-3\" data-name=\"confirm button icon\" data-reason=\"visibility class toggled by updateUI based on state\" id=\"modal-confirm-icon\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <!-- Modal Footer Note -->\n                <div class=\"px-6 py-3 bg-stone-50 border-t border-stone-200/80 flex items-center justify-between text-[11px] text-stone-500\" data-kid=\"1-2-3-1-3\" data-name=\"modal footer note\">\n                    <span class=\"flex items-center gap-1.5\" data-kid=\"1-2-3-1-3-1\" data-name=\"safety note\">\n                        <i class=\"ti ti-lock text-xs text-stone-400\" data-kid=\"1-2-3-1-3-1-1\" data-name=\"lock icon\">\n                        </i>\n                        <span data-kid=\"1-2-3-1-3-1-2\" data-name=\"safety note text\">\n                            Khuyến nghị đăng xuất khi sử dụng máy tính công cộng\n                        </span>\n                    </span>\n                    <span class=\"font-medium text-stone-400\" data-kid=\"1-2-3-1-3-2\" data-name=\"keyboard shortcut note\">\n                        Phím tắt: Esc để hủy\n                    </span>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<script>\n    let currentContext = 'citizen';\n  let currentState = 'modal';\n\n  function updateUI() {\n    const viewCitizen = document.getElementById('view-citizen');\n    const viewAdmin = document.getElementById('view-admin');\n    const ctxCitizenBtn = document.getElementById('ctx-citizen-btn');\n    const ctxAdminBtn = document.getElementById('ctx-admin-btn');\n\n    const dropdownMenu = document.getElementById('citizen-dropdown-menu');\n    const modalBackdrop = document.getElementById('logout-modal-backdrop');\n    const loadingBanner = document.getElementById('modal-loading-banner');\n    const confirmBtn = document.getElementById('modal-confirm-btn');\n    const cancelBtn = document.getElementById('modal-cancel-btn');\n    const confirmSpinner = document.getElementById('modal-confirm-spinner');\n    const confirmLabel = document.getElementById('modal-confirm-label');\n    const confirmIcon = document.getElementById('modal-confirm-icon');\n\n    const stateMenuBtn = document.getElementById('state-menu-btn');\n    const stateModalBtn = document.getElementById('state-modal-btn');\n    const stateLoadingBtn = document.getElementById('state-loading-btn');\n\n    // Update user details inside modal based on context\n    const modalAvatar = document.getElementById('modal-user-avatar');\n    const modalName = document.getElementById('modal-user-name');\n    const modalRole = document.getElementById('modal-user-role-badge');\n    const modalId = document.getElementById('modal-user-identifier');\n\n    if (currentContext === 'citizen') {\n      viewCitizen.classList.remove('hidden');\n      viewCitizen.classList.add('flex');\n      viewAdmin.classList.add('hidden');\n      viewAdmin.classList.remove('flex');\n\n      ctxCitizenBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 bg-[#da251d] text-white shadow-xs cursor-pointer';\n      ctxAdminBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 text-stone-300 hover:text-white cursor-pointer';\n\n      modalAvatar.textContent = 'VA';\n      modalName.textContent = 'Nguyễn Văn An';\n      modalRole.textContent = 'Công dân';\n      modalId.textContent = 'an.nguyen.congdan@gmail.com • CCCD: 079099******';\n    } else {\n      viewCitizen.classList.add('hidden');\n      viewCitizen.classList.remove('flex');\n      viewAdmin.classList.remove('hidden');\n      viewAdmin.classList.add('flex');\n\n      ctxAdminBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 bg-[#da251d] text-white shadow-xs cursor-pointer';\n      ctxCitizenBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 text-stone-300 hover:text-white cursor-pointer';\n\n      modalAvatar.textContent = 'QT';\n      modalName.textContent = 'Quản trị viên Hệ thống';\n      modalRole.textContent = 'Quản trị viên';\n      modalId.textContent = 'Tài khoản: admin2026 • Cổng điều hành Đất đai & HKD';\n    }\n\n    // Reset state buttons\n    const inactiveClass = 'px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-stone-300 hover:text-white cursor-pointer';\n    const activeClass = 'px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-[#ecc15a] text-[#251a00] shadow-xs cursor-pointer';\n    stateMenuBtn.className = currentState === 'menu' ? activeClass : inactiveClass;\n    stateModalBtn.className = currentState === 'modal' ? activeClass : inactiveClass;\n    stateLoadingBtn.className = currentState === 'loading' ? activeClass : inactiveClass;\n\n    if (currentState === 'menu') {\n      dropdownMenu.classList.remove('hidden');\n      modalBackdrop.classList.add('hidden');\n      modalBackdrop.classList.remove('flex');\n    } else if (currentState === 'modal') {\n      dropdownMenu.classList.add('hidden');\n      modalBackdrop.classList.remove('hidden');\n      modalBackdrop.classList.add('flex');\n      loadingBanner.classList.add('hidden');\n      confirmSpinner.classList.add('hidden');\n      confirmIcon.classList.remove('hidden');\n      confirmLabel.textContent = 'Xác nhận đăng xuất';\n      confirmBtn.disabled = false;\n      cancelBtn.disabled = false;\n      confirmBtn.classList.remove('opacity-85', 'cursor-wait');\n    } else if (currentState === 'loading') {\n      dropdownMenu.classList.add('hidden');\n      modalBackdrop.classList.remove('hidden');\n      modalBackdrop.classList.add('flex');\n      loadingBanner.classList.remove('hidden');\n      confirmSpinner.classList.remove('hidden');\n      confirmIcon.classList.add('hidden');\n      confirmLabel.textContent = 'Đang đăng xuất...';\n      confirmBtn.disabled = true;\n      cancelBtn.disabled = true;\n      confirmBtn.classList.add('opacity-85', 'cursor-wait');\n    }\n  }\n\n  function switchContext(ctx) {\n    currentContext = ctx;\n    updateUI();\n  }\n\n  function switchState(st) {\n    currentState = st;\n    updateUI();\n  }\n\n  updateUI();\n</script>\n",
