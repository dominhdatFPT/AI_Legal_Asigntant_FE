      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap');\n@import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400..700,0..1,0');\n</style>\n<div class=\"min-h-screen bg-[#e9e5df] text-[#292823] antialiased [font-family:'Be_Vietnam_Pro',sans-serif]\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Protected sidebar: retain the existing burgundy / gold appearance and layout. -->\n    <aside class=\"fixed left-0 top-0 bottom-0 z-50 flex w-72 flex-col justify-between border-r border-red-900/60 bg-gradient-to-b from-[#6e0d16] via-[#7d141e] to-[#4c070e] text-white shadow-[4px_0_24px_rgba(0,0,0,0.2)]\" data-kid=\"1-1\" data-name=\"fixed burgundy sidebar with navigation\">\n        <div class=\"flex flex-col\" data-kid=\"1-1-1\" data-name=\"sidebar top content column\">\n            <div class=\"flex h-16 items-center gap-2 px-4 border-b border-white/10 bg-black/20 backdrop-blur-sm\" data-kid=\"1-1-1-1\" data-name=\"sidebar brand header bar\">\n                <div class=\"relative shrink-0 rounded-xl bg-gradient-to-tr from-amber-400 via-yellow-300 to-amber-500 p-0.5 shadow-md\" data-kid=\"1-1-1-1-1\" data-name=\"logo badge background frame\">\n                    <img alt=\"Logo Cổng Dịch vụ công Quốc gia\" class=\"h-9 w-9 rounded-full bg-white object-contain\" data-kid=\"1-1-1-1-1-1\" data-name=\"national service logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/AI_Legal/public/images/national-service-logo.png\"/>\n                </div>\n                <div class=\"flex min-w-0 flex-col\" data-kid=\"1-1-1-1-2\" data-name=\"brand text group\">\n                    <span class=\"truncate text-[17px] font-extrabold leading-tight tracking-tight text-white\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name title\">\n                        Hồ sơ đất & HKD\n                    </span>\n                    <span