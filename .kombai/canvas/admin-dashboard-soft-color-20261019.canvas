        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,300..600,0..1,0');\n</style>\n<div class=\"min-h-screen font-['Be_Vietnam_Pro',sans-serif] text-[var(--admin-ink)] antialiased\" data-kid=\"1\" data-name=\"page layout container (dark theme)\" style=\"--admin-page:#190b0f;--admin-sidebar:#2b0c12;--admin-header:#211014;--admin-surface:#241318;--admin-surface-raised:#2b171d;--admin-surface-deep:#1d0f13;--admin-ink:#f6edef;--admin-muted:#b8a7ab;--admin-faint:#927e83;--admin-line:#46272f;--admin-line-strong:#61323b;--admin-red:#c23c47;--admin-red-bright:#db5962;--admin-red-dark:#511821;--admin-red-soft:#401820;--admin-red-tint:#32151b;--admin-sage:#9eb9a2;--admin-sage-bg:#1e3025;--admin-gold:#d5b67d;--admin-shadow:0 12px 32px rgba(4,2,3,.24);background:var(--admin-page)\">\n    <!-- Same left navigation placement and information architecture; updated palette only. -->\n    <aside class=\"fixed left-0 top-0 bottom-0 z-50 flex w-72 flex-col justify-between border-r border-[#54222b] bg-[var(--admin-sidebar)] text-white shadow-[5px_0_28px_rgba(0,0,0,.3)]\" data-kid=\"1-1\" data-name=\"fixed application sidebar (dark)\">\n        <div class=\"flex flex-col\" data-kid=\"1-1-1\" data-name=\"sidebar top section with brand and navigation\">\n            <div class=\"flex h-16 items-center gap-2 border-b border-white/10 bg-black/15 px-4\" data-kid=\"1-1-1-1\" data-name=\"sidebar brand header bar (dark)\">\n                <div class=\"shrink-0 rounded-xl border border-[#a84750] bg-[#48151e] p-0.5 shadow-sm\" data-kid=\"1-1-1-1-1\" data-name=\"government logo badge (dark)\">\n                    <img alt=\"Logo Cổng Dịch vụ công Quốc gia\" class=\"h-9 w-9 rounded-full bg-white object-contain\" data-kid=\"1-1-1-1-1-1\" data-name=\"national service logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/AI_Legal/public/images/national-service-logo.png\"/>\n                </div>\n                <div class=\"flex min-w-0 flex-col\" data-kid=\"1-1-1-1-2\" data-name=\"brand title stack\">\n                    <span class=\"truncate text-[17px] font-extrabold leading-tight tracking-tight text-white\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand primary title text\">\n                        Hồ sơ đất & HKD\n                    </span>\n                    <span class=\"flex items-center gap-1 truncate text-[10px] font-bold tracking-widest text-[#dba1a4]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle with status dot\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#c27d80]\" data-kid=\"1-1-1-1-2-2-1\" data-name=\"online status dot (dark)\">\n                        </span>\n                        Cổng dịch vụ hành chính\n                    </span>\n                </div>\n            </div>\n            <div class=\"px-4 py-2\" data-kid=\"1-1-1-2\" data-name=\"brand divider wrapper\">\n                <div class=\"h-px w-full bg-gradient-to-r from-transparent via-[#a5454f]/50 to-transparent\" data-kid=\"1-1-1-2-1\" data-name=\"decorative gradient divider line (dark)\">\n                </div>\n            </div>\n            <nav aria-label=\"Điều hướng chính\" class=\"flex flex-col gap-1.5 px-4\" data-kid=\"1-1-1-3\" data-name=\"sidebar main navigation\" id=\"sidebar-nav\">\n                <a aria-current=\"page\" class=\"flex items-center gap-2 rounded-xl border-l-4 border-[#e27378] bg-[#6f202a] px-4 py-2.5 font-bold text-white shadow-sm\" data-kid=\"1-1-1-3-1\" data-name=\"active navigation link (dark)\" href=\"#\">\n                    <span class=\"material-symbols-outlined text-[20px] text-[#f2c0c1]\" data-kid=\"1-1-1-3-1-1\" data-name=\"grid view navigation icon (dark)\" style=\"font-variation-settings:'FILL' 1\">\n                        grid_view\n                    </span>\n                    <span class=\"text-[13px] tracking-wide\" data-kid=\"1-1-1-3-1-2\" data-name=\"active navigation link label\">\n                        Tổng quan\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-2 rounded-xl px-4 py-2.5 font-medium text-[#e3cfd1] hover:bg-white/5\" data-kid=\"1-1-1-3-2\" data-name=\"land dossiers navigation link (dark)\" href=\"#\">\n                    <span class=\"material-symbols-outlined text-[20px] text-[#bd777e]\" data-kid=\"1-1-1-3-2-1\" data-name=\"landscape navigation icon (dark)\">\n                        landscape\n                    </span>\n                    <span class=\"text-[13px]\" data-kid=\"1-1-1-3-2-2\" data-name=\"land dossiers navigation label\">\n                        Hồ sơ đất đai\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-2 rounded-xl px-4 py-2.5 font-medium text-[#e3cfd1] hover:bg-white/5\" data-kid=\"1-1-1-3-3\" data-name=\"business household dossiers navigation link (dark)\" href=\"#\">\n                    <span class=\"material-symbols-outlined text-[20px] text-[#bd777e]\" data-kid=\"1-1-1-3-3-1\" data-name=\"storefront navigation icon (dark)\">\n                        storefront\n                    </span>\n                    <span class=\"text-[13px]\" data-kid=\"1-1-1-3-3-2\" data-name=\"business household navigation label\">\n                        Hồ sơ hộ kinh doanh\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-2 rounded-xl px-4 py-2.5 font-medium text-[#e3cfd1] hover:bg-white/5\" data-kid=\"1-1-1-3-4\" data-name=\"user management navigation link (dark)\" href=\"#\">\n                    <span class=\"material-symbols-outlined text-[20px] text-[#bd777e]\" data-kid=\"1-1-1-3-4-1\" data-name=\"group navigation icon (dark)\">\n                        group\n                    </span>\n                    <span class=\"text-[13px]\" data-kid=\"1-1-1-3-4-2\" data-name=\"user management navigation label\">\n                        Quản lí người dùng\n                    </span>\n                </a>\n            </nav>\n        </div>\n        <div class=\"border-t border-white/10 bg-black/15 p-4\" data-kid=\"1-1-2\" data-name=\"sidebar user footer section (dark)\">\n            <div class=\"flex items-center justify-between gap-2 rounded-xl border border-white/10 bg-white/[.045] p-2.5\" data-kid=\"1-1-2-1\" data-name=\"user profile card (dark)\">\n                <div class=\"flex min-w-0 items-center gap-2\" data-kid=\"1-1-2-1-1\" data-name=\"user profile info group\">\n                    <div class=\"grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[#7c3038] text-[#f7dfe1]\" data-kid=\"1-1-2-1-1-1\" data-name=\"user avatar circle (dark)\">\n                        <span class=\"material-symbols-outlined text-[18px]\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"person avatar icon (dark)\" style=\"font-variation-settings:'FILL' 1\">\n                            person\n                        </span>\n                    </div>\n                    <div class=\"flex min-w-0 flex-col\" data-kid=\"1-1-2-1-1-2\" data-name=\"username and role stack\">\n                        <span class=\"truncate text-[13px] font-bold text-white\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"display username text\">\n                            Người dùng\n                        </span>\n                        <span class=\"flex items-center gap-1 truncate text-[11px] font-medium text-[#dcb9bc]\" data-kid=\"1-1-2-1-1-2-2\" data-name=\"admin role label with badge (dark)\">\n                            <span class=\"material-symbols-outlined text-[12px]\" data-kid=\"1-1-2-1-1-2-2-1\" data-name=\"badge role icon (dark)\">\n                                badge\n                            </span>\n                            Quản trị viên\n                        </span>\n                    </div>\n                </div>\n                <a aria-label=\"Đăng xuất\" class=\"grid h-8 w-8 shrink-0 place-items-center rounded-lg text-[#dcb9bc] hover:bg-white/10\" data-kid=\"1-1-2-1-2\" data-name=\"logout action button (dark)\" href=\"#\" title=\"Đăng xuất\">\n                    <span class=\"material-symbols-outlined text-[19px]\" data-kid=\"1-1-2-1-2-1\" data-name=\"logout icon (dark)\">\n                        logout\n                    </span>\n                </a>\n            </div>\n        </div>\n    </aside>\n    <div class=\"pl-72\" data-kid=\"1-2\" data-name=\"main content area offset by sidebar\">\n        <!-- Header keeps the same location, height, and contents. -->\n        <header class=\"fixed left-72 right-0 top-0 z-40 flex h-16 items-center justify-between border-b border-[#48242c] bg-[var(--admin-header)]/95 px-6 shadow-[0_3px_14px_rgba(0,0,0,.16)] backdrop-blur-xl\" data-kid=\"1-2-1\" data-name=\"fixed top application header (dark)\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-2-1-1\" data-name=\"header left group\">\n                <span class=\"text-[13px] font-bold text-[#e5b4b8]\" data-kid=\"1-2-1-1-1\" data-name=\"header section label text (dark)\">\n                    Cổng hành chính\n                </span>\n                <span class=\"flex items-center gap-1.5 rounded-full border border-[#385243] bg-[#1c2b22] px-3 py-1 text-[11px] font-bold text-[#b6d1bb]\" data-kid=\"1-2-1-1-2\" data-name=\"online status pill (dark)\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#8cae92]\" data-kid=\"1-2-1-1-2-1\" data-name=\"online status indicator dot (dark)\">\n                    </span>\n                    Hệ thống trực tuyến\n                </span>\n            </div>\n            <button class=\"flex items-center gap-2 rounded-lg border border-[#57323a] bg-[#2b171d] px-3.5 py-1.5 text-[#f1e6e7] shadow-sm\" data-kid=\"1-2-1-2\" data-name=\"dept account selector button (dark)\" type=\"button\">\n                <span class=\"material-symbols-outlined text-[18px] text-[#df8c91]\" data-kid=\"1-2-1-2-1\" data-name=\"domain icon (dark)\">\n                    domain\n                </span>\n                <span class=\"text-[13px] font-bold\" data-kid=\"1-2-1-2-2\" data-name=\"selected department name\">\n                    Văn phòng Đăng ký Đất đai\n                </span>\n                <span class=\"material-symbols-outlined text-[16px] text-[#d7b4a2]\" data-kid=\"1-2-1-2-3\" data-name=\"dropdown expand icon (dark)\">\n                    expand_more\n                </span>\n                <span class=\"h-5 w-px bg-[#59343b]\" data-kid=\"1-2-1-2-4\" data-name=\"dropdown separator (dark)\">\n                </span>\n                <span class=\"grid h-8 w-8 place-items-center rounded-full border border-[#86414a] bg-[#65212b] text-white\" data-kid=\"1-2-1-2-5\" data-name=\"account avatar chip (dark)\">\n                    <span class=\"material-symbols-outlined text-[18px]\" data-kid=\"1-2-1-2-5-1\" data-name=\"account person icon (dark)\">\n                        person\n                    </span>\n                </span>\n            </button>\n        </header>\n        <main class=\"min-h-screen px-7 pb-12 pt-24\" data-kid=\"1-2-2\" data-name=\"main dashboard content (dark)\" style=\"background:linear-gradient(145deg,#1b0b10 0%,#160a0d 65%,#1d0b11 100%)\">\n            <div class=\"mx-auto flex max-w-[1480px] flex-col gap-5\" data-kid=\"1-2-2-1\" data-name=\"dashboard content column (asymmetric bento)\">\n                <div class=\"grid grid-cols-12 gap-4\" data-kid=\"1-2-2-1-1\" data-name=\"bento dashboard tile grid\">\n                    <!-- Large welcome/search tile: primary anchor of the asymmetric Bento layout. -->\n                    <section class=\"col-span-8 flex min-h-[244px] flex-col justify-between overflow-hidden rounded-2xl border border-[#51242c] bg-[var(--admin-surface)] p-6 shadow-[var(--admin-shadow)]\" data-kid=\"1-2-2-1-1-1\" data-name=\"welcome and search tile\">\n                        <div class=\"flex items-start justify-between gap-5\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"header row with greeting and demo badge\">\n                            <div class=\"min-w-0\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"greeting block\">\n                                <span class=\"inline-flex items-center gap-2 rounded-full border border-[#6b3038] bg-[#39181e] px-3 py-1.5 text-[10px] font-semibold tracking-wide text-[#e6b9bc]\" data-kid=\"1-2-2-1-1-1-1-1-1\" data-name=\"verified portal pill (dark)\">\n                                    <span class=\"material-symbols-outlined text-[15px] text-[#d77b82]\" data-kid=\"1-2-2-1-1-1-1-1-1-1\" data-name=\"verified checkmark icon (dark)\">\n                                        verified\n                                    </span>\n                                    Cổng tiếp nhận & thẩm định hành chính số\n                                </span>\n                                <h1 class=\"mt-3 text-[29px] font-bold leading-tight tracking-[-.025em] text-[var(--admin-ink)]\" data-kid=\"1-2-2-1-1-1-1-1-2\" data-name=\"hero greeting headline (dark)\">\n                                    Xin chào, Người dùng\n                                </h1>\n                                <p class=\"mt-1.5 max-w-xl text-[13px] leading-5 text-[var(--admin-muted)]\" data-kid=\"1-2-2-1-1-1-1-1-3\" data-name=\"hero descriptive text (dark)\">\n                                    Số liệu bên dưới lấy trực tiếp từ cơ sở dữ liệu hồ sơ.\n                                </p>\n                            </div>\n                            <span class=\"shrink-0 rounded-md border border-[#57333a] bg-[#1c1014] px-2.5 py-1.5 text-[9px] font-bold tracking-[.08em] text-[#c7aeb1]\" data-kid=\"1-2-2-1-1-1-1-2\" data-name=\"demo data preview badge\">\n                                BẢN XEM THỬ · DỮ LIỆU MẪU\n                            </span>\n                        </div>\n                        <div class=\"mt-5 flex items-center gap-2 rounded-xl border border-[#493039] bg-[var(--admin-surface-deep)] p-2\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"search bar container (dark)\">\n                            <div class=\"relative w-[190px] shrink-0\" data-kid=\"1-2-2-1-1-1-2-1\" data-name=\"search category select wrapper (dark)\">\n                                <select class=\"h-11 w-full appearance-none rounded-lg border border-[#51343b] bg-[#2a171c] px-3.5 pr-9 text-[12px] font-semibold text-[#f1e5e7] outline-none\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-1-2-1-1\" data-name=\"search category dropdown (dark)\" data-reason=\"options replaced by script from dossier type data\">\n                                    <option data-kid=\"1-2-2-1-1-1-2-1-1-1\" data-name=\"all dossiers option\">\n                                        📁 Tất cả hồ sơ\n                                    </option>\n                                    <option data-kid=\"1-2-2-1-1-1-2-1-1-2\" data-name=\"land dossiers option\">\n                                        🏞️ Hồ sơ đất đai\n                                    </option>\n                                    <option data-kid=\"1-2-2-1-1-1-2-1-1-3\" data-name=\"business household option\">\n                                        🏪 Hộ kinh doanh\n                                    </option>\n                                    <option data-kid=\"1-2-2-1-1-1-2-1-1-4\" data-name=\"owner/ID option\">\n                                        👤 Chủ sở hữu / CCCD\n                                    </option>\n                                </select>\n                                <span class=\"material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-[17px] text-[#c39498]\" data-kid=\"1-2-2-1-1-1-2-1-2\" data-name=\"select expand chevron (dark)\">\n                                    expand_more\n                                </span>\n                            </div>\n                            <div class=\"relative flex min-w-0 flex-1 items-center\" data-kid=\"1-2-2-1-1-1-2-2\" data-name=\"search input wrapper (dark)\">\n                                <span class=\"material-symbols-outlined absolute left-3 text-[20px] text-[#d16a72]\" data-kid=\"1-2-2-1-1-1-2-2-1\" data-name=\"search icon (dark)\">\n                                    search\n                                </span>\n                                <input class=\"h-11 w-full bg-transparent pl-10 pr-16 text-[12px] text-[#f4e9ea] outline-none placeholder:text-[#907d82]\" data-kid=\"1-2-2-1-1-1-2-2-2\" data-name=\"dossier search input field (dark)\" placeholder=\"Nhập mã hồ sơ, CCCD, tên hộ kinh doanh hoặc thửa đất...\" type=\"text\"/>\n                                <span class=\"absolute right-2 rounded border border-[#52353c] bg-[#2b1a1f] px-2 py-0.5 text-[10px] font-medium text-[#bda8ab]\" data-kid=\"1-2-2-1-1-1-2-2-3\" data-name=\"keyboard shortcut hint (dark)\">\n                                    Ctrl + K\n                                </span>\n                            </div>\n                            <button class=\"flex h-11 shrink-0 items-center gap-2 rounded-lg bg-[var(--admin-red)] px-4 text-[12px] font-bold text-white shadow-[0_5px_15px_rgba(115,25,34,.25)]\" data-kid=\"1-2-2-1-1-1-2-3\" data-name=\"search submit button (dark)\" type=\"button\">\n                                <span class=\"material-symbols-outlined text-[18px]\" data-kid=\"1-2-2-1-1-1-2-3-1\" data-name=\"search explore icon (dark)\">\n                                    travel_explore\n                                </span>\n                                Tìm kiếm\n                            </button>\n                        </div>\n                    </section>\n                    <!-- One larger, operationally important tile replaces the old row of equally loud cards. -->\n                    <article class=\"relative col-span-4 row-span-2 flex min-h-[410px] flex-col justify-between overflow-hidden rounded-2xl border border-[#81343d] bg-[linear-gradient(145deg,#511b24_0%,#35141b_78%)] p-6 shadow-[var(--admin-shadow)]\" data-kid=\"1-2-2-1-1-2\" data-name=\"feature pending dossiers spotlight tile\">\n                        <div class=\"absolute -right-14 -top-14 h-48 w-48 rounded-full bg-[#c33b47]/10 blur-3xl\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"decorative blurred highlight circle\">\n                        </div>\n                        <div class=\"relative flex items-start justify-between\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"spotlight tile header row\">\n                            <div data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"spotlight eyebrow and title stack\">\n                                <span class=\"text-[10px] font-bold tracking-[.12em] text-[#e2a5a9]\" data-kid=\"1-2-2-1-1-2-2-1-1\" data-name=\"spotlight eyebrow label\">\n                                    HỒ SƠ ĐANG XỬ LÝ\n                                </span>\n                                <h2 class=\"mt-2 text-[14px] font-semibold text-[#f8ecee]\" data-kid=\"1-2-2-1-1-2-2-1-2\" data-name=\"spotlight feature title\">\n                                    Đang chờ xử lý\n                                </h2>\n                            </div>\n                            <span class=\"grid h-11 w-11 place-items-center rounded-xl border border-[#98505a]/60 bg-[#62222c] text-[#f0c1c4]\" data-kid=\"1-2-2-1-1-2-2-2\" data-name=\"spotlight icon container\">\n                                <span class=\"material-symbols-outlined text-[23px]\" data-kid=\"1-2-2-1-1-2-2-2-1\" data-name=\"assignment late icon (dark)\">\n                                    assignment_late\n                                </span>\n                            </span>\n                        </div>\n                        <div class=\"relative\" data-kid=\"1-2-2-1-1-2-3\" data-name=\"spotlight count and caption block\">\n                            <p class=\"text-[64px] font-bold leading-none tracking-[-.06em] text-white\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2-3-1\" data-name=\"spotlight pending count\" data-reason=\"number text rendered from fetched database count\">\n                                96\n                            </p>\n                            <p class=\"mt-3 max-w-[230px] text-[12px] leading-5 text-[#d7b9bc]\" data-kid=\"1-2-2-1-1-2-3-2\" data-name=\"spotlight descriptive caption\">\n                                Hồ sơ đã nộp và đang được tiếp nhận xử lý.\n                            </p>\n                        </div>\n                        <div class=\"relative border-t border-white/10 pt-4\" data-kid=\"1-2-2-1-1-2-4\" data-name=\"spotlight progress footer\">\n                            <div class=\"mb-3 flex items-center justify-between text-[10px] text-[#d5b4b8]\" data-kid=\"1-2-2-1-1-2-4-1\" data-name=\"spotlight status label row\">\n                                <span data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2-4-1-1\" data-name=\"spotlight status label\" data-reason=\"status label derived from live processing state\">\n                                    Trạng thái tiếp nhận\n                                </span>\n                                <span class=\"font-semibold text-[#f0d5d7]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2-4-1-2\" data-name=\"spotlight status value\" data-reason=\"status value overwritten from live processing state\">\n                                    Đang cập nhật\n                                </span>\n                            </div>\n                            <div class=\"h-1.5 overflow-hidden rounded-full bg-[#32151b]\" data-kid=\"1-2-2-1-1-2-4-2\" data-name=\"pending progress track\">\n                                <div class=\"h-full w-[62%] rounded-full bg-[#cf5962]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2-4-2-1\" data-name=\"pending progress fill\" data-reason=\"width percentage recomputed from live data\">\n                                </div>\n                            </div>\n                            <div class=\"mt-4 flex items-center gap-2 text-[11px] text-[#e0c3c6]\" data-kid=\"1-2-2-1-1-2-4-3\" data-name=\"priority watch hint row\">\n                                <span class=\"h-1.5 w-1.5 rounded-full bg-[#d46a72]\" data-kid=\"1-2-2-1-1-2-4-3-1\" data-name=\"priority watch indicator dot\">\n                                </span>\n                                Ưu tiên theo dõi\n                            </div>\n                        </div>\n                    </article>\n                    <!-- Supporting metric tiles have varied spans and a quieter surface treatment. -->\n                    <article class=\"col-span-3 flex min-h-[150px] flex-col justify-between rounded-2xl border border-[var(--admin-line)] bg-[var(--admin-surface-raised)] p-4 shadow-[var(--admin-shadow)]\" data-kid=\"1-2-2-1-1-3\" data-name=\"total dossiers metric tile (compact)\">\n                        <div class=\"flex items-start justify-between\" data-kid=\"1-2-2-1-1-3-1\" data-name=\"metric label and icon row\">\n                            <span class=\"max-w-[150px] text-[11px] font-medium leading-4 text-[var(--admin-muted)]\" data-kid=\"1-2-2-1-1-3-1-1\" data-name=\"metric label text (compact)\">\n                                Tổng hồ sơ tiếp nhận\n                            </span>\n                            <span class=\"grid h-9 w-9 place-items-center rounded-lg bg-[var(--admin-red-soft)] text-[#df8c92]\" data-kid=\"1-2-2-1-1-3-1-2\" data-name=\"metric icon container (compact)\">\n                                <span class=\"material-symbols-outlined text-[20px]\" data-kid=\"1-2-2-1-1-3-1-2-1\" data-name=\"folder open icon (compact)\">\n                                    folder_open\n                                </span>\n                            </span>\n                        </div>\n                        <div data-kid=\"1-2-2-1-1-3-2\" data-name=\"metric count and caption stack\">\n                            <strong class=\"text-[28px] font-bold tracking-tigh