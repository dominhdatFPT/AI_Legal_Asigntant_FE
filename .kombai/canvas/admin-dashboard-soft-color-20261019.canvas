sults count text (dark)\" data-reason=\"displayed and total count rendered from live database\">\n                            Hiển thị 1 - 3 trên 1.284 hồ sơ mẫu\n                        </span>\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-3-3-2\" data-name=\"pagination controls (dark)\">\n                            <button aria-label=\"Trang trước\" class=\"grid h-8 w-8 place-items-center rounded-lg border border-[var(--admin-line)] text-[var(--admin-muted)]\" data-kid=\"1-2-2-1-3-3-2-1\" data-name=\"previous page button (dark)\">\n                                <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-2-1-3-3-2-1-1\" data-name=\"chevron left icon (dark)\">\n                                    chevron_left\n                                </span>\n                            </button>\n                            <span class=\"text-[10px] font-medium text-[var(--admin-ink)]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-3-3-2-2\" data-name=\"current page indicator (dark)\" data-reason=\"page number and total pages updated from live dataset\">\n                                1 / 129\n                            </span>\n                            <button aria-label=\"Trang sau\" class=\"grid h-8 w-8 place-items-center rounded-lg border border-[var(--admin-line)] text-[var(--admin-muted)]\" data-kid=\"1-2-2-1-3-3-2-3\" data-name=\"next page button (dark)\">\n                                <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-2-1-3-3-2-3-1\" data-name=\"chevron right icon (dark)\">\n                                    chevron_right\n                                </span>\n                            </button>\n                        </div>\n                    </div>\n                </section>\n            </div>\n        </main>\n    </div>\n    <!-- Compact red chat control stays reachable without covering table content. -->\n    <button aria-label=\"Mở chatbot hỗ trợ tra cứu thủ tục\" class=\"fixed bottom-6 right-6 z-[90] grid h-14 w-14 place-items-center rounded-full border border-[#a3424c] bg-[#8a2631] text-[#fff4f4] shadow-[0_10px_26px_rgba(4,2,3,.4)]\" data-kid=\"1-3\" data-name=\"floating chatbot button (corner)\" title=\"Chatbot hỗ trợ — Tra cứu thủ tục, chuẩn bị hồ sơ\" type=\"button\">\n        <span class=\"material-symbols-outlined text-[23px]\" data-kid=\"1-3-1\" data-name=\"chat icon (dark)\">\n            chat\n        </span>\n        <span class=\"absolute -right-1 -top-1 h-3 w-3 rounded-full border-2 border-[#190b0f] bg-[#d78388]\" data-kid=\"1-3-2\" data-name=\"chat notification dot\">\n        </span>\n    </button>\n</div>\n",
